# ==============================================================================
# Lumina / Blogify Environment Configuration Template
# ==============================================================================

# Core Application Settings
NODE_ENV=production
PORT=10000
BASE_URL=https://your-service.onrender.com

# Authentication & Sessions (Generate strong 32+ character random strings)
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_key_here

# Database (MongoDB Atlas connection string)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/blogify?retryWrites=true&w=majority

# Upstash / Managed Redis (Required for distributed sessions, rate limits & multi-instance Socket.io)
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# Google Gemini AI APIs
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_GEMINI_MODEL=gemini-2.5-flash
GOOGLE_GEMINI_KEY_LIGHT=your_secondary_gemini_key_here
GOOGLE_EMBEDDING_API_KEY=your_gemini_embedding_key_here

# Cloudinary (Media storage & image optimization)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth Login (OPTIONAL — leave both unset to disable "Continue with
# Google"; the app boots fine without them and hides the button.)
# Authorized redirect URI: https://<your-render-subdomain>.onrender.com/user/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Verification & Password Resets (Gmail SMTP with App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_16_character_app_password

# GIPHY API (Optional: comment/post GIF integration)
GIPHY_API_KEY=your_giphy_api_key

# ------------------------------------------------------------------------------
# Operational knobs (all optional — sensible defaults apply)
# ------------------------------------------------------------------------------

# Protects GET /cron/publish-scheduled. Accepted as "Authorization: Bearer <v>",
# an "x-cron-secret" header, or "?secret=". Leave unset to run the endpoint open.
CRON_SECRET=

# Requires "Authorization: Bearer <value>" on GET /metrics. Unset = public.
METRICS_TOKEN=

# Logging: error|warn|info|debug (default: info)
LOG_LEVEL=info

# Mongo connection pool ceiling (default: 10)
MONGO_POOL_SIZE=10

# Anonymous HTML micro-cache for "/" and "/blog/:id" (default TTL 60s).
# PAGE_CACHE_DISABLED=true turns it off entirely.
PAGE_CACHE_TTL_SECONDS=60
PAGE_CACHE_DISABLED=false

# Background jobs. The web process runs the worker in-process by default; set
# QUEUE_WORKER_INLINE=false when running a separate `node worker.js` service.
# QUEUE_DISABLED=true runs every job inline instead of via BullMQ.
QUEUE_WORKER_INLINE=true
QUEUE_DISABLED=false
QUEUE_CONCURRENCY=5

# REDIS_DISABLED=true ignores REDIS_URL and falls back to Mongo sessions and
# in-process caches/rate-limits — useful when a managed Redis quota is exhausted.
REDIS_DISABLED=false

# Atlas Vector Search index name on blogs.embedding (default: blog_vector_index).
# Without the index the app falls back to in-memory cosine similarity.
VECTOR_INDEX_NAME=blog_vector_index

# Persistent real-time host for Socket.IO when the app itself is on serverless.
SOCKET_URL=
