<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/header') %>
        <link rel="stylesheet" href="/css/home.css?v=18">
</head>

<body>
    <%- include('./partials/nav', { searchQuery: '' }) %>

        <div class="feed-hero">
            <div class="feed-header">
                <h1 class="feed-title">Fresh <span class="outline-text">Perspectives</span></h1>
                <p class="feed-description">
                    A minimalist sanctuary where builders share insights and shape the future of tech.
                </p>
                <p class="feed-date">
                    <%= moment().format('dddd, MMMM Do YYYY') %>
                </p>
            </div>
            <div class="feed-filter">
                <button class="filter-btn active" data-category="all">All</button>
                <button class="filter-btn" data-category="trending">Trending</button>
                <button class="filter-btn" data-category="featured">Featured</button>
                <% categories.slice(0, 6).forEach(cat=> { %>
                    <button class="filter-btn" data-category="<%= cat.toLowerCase() %>">
                        <%= cat %>
                    </button>
                    <% }) %>

            </div>

            <% if (typeof trendingTagsList !=='undefined' && trendingTagsList.length> 0) { %>
                <div class="feed-tags">
                    <% trendingTagsList.forEach(tag=> { %>
                        <%# Tags contain spaces ("Artificial Intelligence"), so the value has to be
                            encoded for the URL. The label strips a leading "#" because a few stored
                            tags already carry one, which rendered as "##poetry". %>
                        <a href="/?tag=<%= encodeURIComponent(tag._id) %>" class="tag-chip">#<%= String(tag._id).replace(/^#+/, '') %></a>
                        <% }) %>
                </div>
                <% } %>
        </div>

        <div class="feed-divider"></div>

        <!-- 🕘 Continue Reading -->
        <% if (locals.recentlyRead && recentlyRead.length > 0) { %>
            <section class="continue-reading">
                <div class="cr-head">
                    <h3 class="cr-title">Continue Reading</h3>
                    <a href="/user/reading-history" class="cr-all">View all →</a>
                </div>
                <div class="cr-row">
                    <% recentlyRead.forEach(blog => { %>
                        <a href="/blog/<%= blog.slug || blog._id %>" class="cr-card">
                            <img loading="lazy"
                                 src="<%= typeof optimizeImage === 'function' ? optimizeImage(blog.coverImageURL || '/images/default-cover.png', { width: 300, crop: 'fill' }) : (blog.coverImageURL || '/images/default-cover.png') %>"
                                 alt="" class="cr-img" data-fallback="/images/default-cover.png">
                            <div class="cr-info">
                                <span class="cr-name"><%= blog.title %></span>
                                <span class="cr-meta"><%= blog.createdBy ? blog.createdBy.fullName : 'Unknown' %> · <%= blog.readTime || 1 %> min</span>
                            </div>
                        </a>
                    <% }) %>
                </div>
            </section>
            <style>
                .continue-reading { max-width: 1400px; margin: 2rem auto 0; padding: 0 2rem; }
                .cr-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 1rem; }
                .cr-title { font-size: 1.1rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-color); margin: 0; opacity: 0.8; }
                .cr-all { font-size: 0.8rem; font-weight: 600; color: #6366f1; text-decoration: none; }
                .cr-row { display: flex; gap: 1rem; overflow-x: auto; padding-bottom: 0.5rem; scrollbar-width: none; }
                .cr-row::-webkit-scrollbar { display: none; }
                .cr-card { flex: 0 0 260px; display: flex; gap: 0.8rem; align-items: center; text-decoration: none; color: inherit;
                    background: var(--bg-color); border: 1px solid var(--border-color); border-radius: 12px; padding: 0.7rem; transition: transform 0.2s, box-shadow 0.2s; }
                .cr-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,0.08); }
                .cr-img { width: 72px; height: 54px; object-fit: cover; border-radius: 8px; flex-shrink: 0; background: var(--accent-gray); }
                .cr-info { min-width: 0; display: flex; flex-direction: column; gap: 0.25rem; }
                .cr-name { font-size: 0.92rem; font-weight: 700; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
                .cr-meta { font-size: 0.72rem; color: #888; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
            </style>
        <% } %>

        <!-- Bento Feed Wrapper -->
        <div class="bento-feed-wrapper" style="margin-top: 2rem;">
            <!-- No initial skeleton: the cards below are server-rendered, so they
                 are already in this HTML. This used to show eight placeholder
                 tiles while the real feed sat underneath at `opacity: 0`, and
                 only revealed it on `window.load` (which waits for every image)
                 plus an 800ms timer -- so the page deliberately hid content it
                 had already delivered. The pagination skeleton further down is
                 still used, for infinite scroll, where there is really nothing
                 to show yet. -->

            <!-- Bento Grid Feed -->
            <div class="bento-grid" id="bento-grid" style="transition: opacity 0.25s ease;">
                <% if (blogs && blogs.length> 0) { %>
                    <% blogs.forEach((blog, index)=> {
                        let bentoClass = 'item-normal';
                        const pattern = index % 8;
                        if (pattern === 0) bentoClass = 'item-main';
                        else if (pattern === 3) bentoClass = 'item-wide';
                        else if (pattern === 4) bentoClass = 'item-tall';
                        else if (pattern === 7) bentoClass = 'item-wide';

                        // Determine categories for filtering
                        let dataCats = ['all'];
                        if (blog.category) dataCats.push(blog.category.toLowerCase());
                        if (blog.featured) dataCats.push('featured');
                        // We can simulate trending if needed, or use views
                        if (blog.views > 10) dataCats.push('trending');
                        %>
                        <article class="bento-item <%= bentoClass %>" data-categories='<%= JSON.stringify(dataCats) %>'
                            style="view-transition-name: item-<%= blog._id %>;">
                            <div class="bento-glow"></div>
                            <a href="/blog/<%= blog.slug || blog._id %>" class="blog-card-link">
                                <div class="blog-card-inner">
                                    <div class="card-image-wrapper">
                                        <% if (blog.coverImageURL) { %>
                                            <img loading="lazy" src="<%= typeof optimizeImage === 'function' ? optimizeImage(blog.coverImageURL, { width: 600, crop: 'fill' }) : blog.coverImageURL %>" alt="<%= blog.title %>" loading="lazy" data-fallback="/images/default-cover.png">
                                            <% } else { %>
                                                <div class="placeholder-img"></div>
                                                <% } %>
                                                    <div class="card-overlay">
                                                        <span class="read-time">
                                                            <%= blog.readTime || 1 %> min read
                                                        </span>
                                                    </div>
                                    </div>
                                    <div class="card-content">
                                        <div class="card-tags">
                                            <!-- AI Match Badge -->

                                            <% if (blog.category) { %>
                                                <span class="tag-pill">
                                                    <%= blog.category %>
                                                </span>
                                                <% } %>
                                        </div>
                                        <h2 class="card-heading">
                                            <%= blog.title %>
                                        </h2>
                                        <div class="card-footer-minimal">
                                            <% if (blog.createdBy) { %>
                                                <div class="author-info">
                                                    <% if (blog.createdBy.profilePic) { %>
                                                        <img loading="lazy" src="<%= typeof optimizeImage === 'function' ? optimizeImage(blog.createdBy.profilePic, { width: 48, crop: 'fill' }) : blog.createdBy.profilePic %>" alt="Author"
                                                            class="author-avatar-small" data-fallback="/images/default-avatar.png">
                                                        <% } else { %>
                                                            <div class="author-avatar-small placeholder"></div>
                                                            <% } %>
                                                                <span class="author-name">
                                                                    <%= blog.createdBy.fullName %>
                                                                </span>
                                                </div>
                                                <% } %>
                                                    <div class="interaction-stats">
                                                        <span><i class="far fa-eye"></i>
                                                            <%= blog.views || 0 %>
                                                        </span>
                                                    </div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </article>
                        <% }) %>
                            <% } else { %>
                                <div class="empty-feed">
                                    <div class="empty-icon"><i class="fas fa-pen"></i></div>
                                    <h3>The Canvas is Blank</h3>
                                    <p>Be the first to paint a story on this timeline.</p>
                                    <a href="/blog/add-new" class="btn-primary btn-lg mt-3">Start Writing</a>
                                </div>
                                <% } %>
            </div>

            <!-- Pagination Skeleton -->
            <div class="skeleton-container" id="pagination-skeleton" style="display: none; opacity: 1;">
                <div class="skeleton-item item-normal"></div>
                <div class="skeleton-item item-normal"></div>
                <div class="skeleton-item item-normal"></div>
                <div class="skeleton-item item-normal"></div>
            </div>

            <!-- Sentinel for Infinite Scroll -->
            <div id="sentinel" style="height: 20px; width: 100%;"></div>
        </div>


        <!-- Sanitizer -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.0.6/purify.min.js"></script>
        <script nonce="<%= cspNonce %>">

            let currentPage = 1;
            let isLoading = false;
            let hasMore = true;
            let currentCategory = '<%= categoryFilter || "all" %>';

            // Mark the chip matching the current URL. This runs on
            // DOMContentLoaded rather than `load`: it only touches markup that
            // is already parsed, so there is no reason to wait for images.
            const syncActiveChip = () => {
                document.querySelectorAll('.filter-btn').forEach(btn => {
                    btn.classList.toggle(
                        'active',
                        btn.getAttribute('data-category') === currentCategory
                    );
                });
            };
            document.addEventListener('DOMContentLoaded', syncActiveChip);

            // --- Bento pattern ---
            const filterBtns = document.querySelectorAll('.filter-btn');
            const bentoGrid = document.getElementById('bento-grid');

            // The grid's visual rhythm comes from the card's position, so it has
            // to be reassigned whenever cards are added or replaced. The pattern
            // here is the same one home.ejs applies server-side.
            //
            // The appended-cards path used to call `applyFilter(currentCategory)`
            // here, but `applyFilter` was never defined -- it threw a
            // ReferenceError on every infinite-scroll batch, which the caller's
            // try/catch swallowed as "Error loading more blogs".
            const BENTO = { 0: 'item-main', 3: 'item-wide', 4: 'item-tall', 7: 'item-wide' };
            const updateBentoPattern = () => {
                const items = bentoGrid.querySelectorAll('.bento-item');
                items.forEach((el, i) => {
                    el.classList.remove('item-main', 'item-wide', 'item-tall', 'item-normal');
                    el.classList.add(BENTO[i % 8] || 'item-normal');
                });
            };

            // --- Filter chips: swap the cards, not the whole page ---
            //
            // A chip click used to do `window.location.href = '/?category=x'`,
            // re-rendering the entire page -- nav, rails, trending tags,
            // personalization, every query behind them -- to change eight cards.
            // The JSON feed already returns exactly those cards, so the chip now
            // fetches them and swaps the grid, and pushState keeps the URL and
            // the back button honest. A direct hit on /?category=x is still
            // server-rendered, so links and no-JS loads are unaffected.
            let currentTag = new URLSearchParams(location.search).get('tag') || '';

            const feedUrl = (page) =>
                `/blog/api/feed?page=${page}` +
                `&category=${encodeURIComponent(currentCategory)}` +
                (currentTag ? `&tag=${encodeURIComponent(currentTag)}` : '');

            const switchFilter = async (category, { push = true } = {}) => {
                if (isLoading) return;
                isLoading = true;
                currentCategory = category;
                currentTag = '';
                currentPage = 1;
                hasMore = true;
                syncActiveChip();
                bentoGrid.style.opacity = '0.45';

                if (push) {
                    const url = category === 'all' ? '/' : `/?category=${encodeURIComponent(category)}`;
                    history.pushState({ category }, '', url);
                }

                try {
                    const res = await fetch(feedUrl(1), { headers: { 'Accept': 'application/json' } });
                    if (!res.ok) throw new Error('feed ' + res.status);
                    const data = await res.json();
                    hasMore = !!data.hasMore;
                    bentoGrid.replaceChildren();
                    renderNewBlogs(data.blogs || []);
                    if (!(data.blogs || []).length) {
                        bentoGrid.innerHTML =
                            '<p class="bento-empty">Nothing here yet. Try another filter.</p>';
                    }
                } catch (err) {
                    // Don't leave the reader on a half-swapped grid: fall back to
                    // the server-rendered page, which is what used to happen anyway.
                    console.error('Filter switch failed, falling back to navigation:', err);
                    window.location.href =
                        currentCategory === 'all' ? '/' : `/?category=${encodeURIComponent(currentCategory)}`;
                    return;
                } finally {
                    isLoading = false;
                    bentoGrid.style.opacity = '1';
                }
            };

            filterBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    const category = btn.getAttribute('data-category');
                    if (category !== currentCategory) switchFilter(category);
                });
            });

            // Back/forward through filters the reader applied.
            window.addEventListener('popstate', () => {
                const next = new URLSearchParams(location.search).get('category') || 'all';
                const nextTag = new URLSearchParams(location.search).get('tag') || '';
                if (nextTag) { window.location.reload(); return; }
                if (next !== currentCategory) switchFilter(next, { push: false });
            });

            // --- Infinite Scroll Logic ---
            const loadMoreBlogs = async () => {
                if (isLoading || !hasMore) return;
                isLoading = true;

                const pagSkeleton = document.getElementById('pagination-skeleton');
                pagSkeleton.style.display = 'grid';

                try {
                    const response = await fetch(feedUrl(currentPage + 1));
                    const data = await response.json();

                    if (data.blogs && data.blogs.length > 0) {
                        currentPage++;
                        hasMore = data.hasMore;
                        renderNewBlogs(data.blogs);
                    } else {
                        hasMore = false;
                    }
                } catch (error) {
                    console.error('Error loading more blogs:', error);
                } finally {
                    isLoading = false;
                    pagSkeleton.style.display = 'none';
                }
            };

            const renderNewBlogs = (blogs) => {
                const fragment = document.createDocumentFragment();

                blogs.forEach(blog => {
                    // Check if item already exists in DOM (can happen with client-side filters)
                    if (document.querySelector(`[style*="item-${blog._id}"]`)) return;

                    const article = document.createElement('article');
                    article.className = 'bento-item item-normal'; // Default, will be recalculated
                    article.style.viewTransitionName = `item-${blog._id}`;

                    let dataCats = ['all'];
                    if (blog.category) dataCats.push(blog.category.toLowerCase());
                    if (blog.featured) dataCats.push('featured');
                    if (blog.views > 10) dataCats.push('trending');
                    article.setAttribute('data-categories', JSON.stringify(dataCats));

                    article.innerHTML = DOMPurify.sanitize(`
                            <div class="bento-glow"></div>
                                <a href="/blog/${blog.slug || blog._id}" class="blog-card-link">
                                    <div class="blog-card-inner">
                                        <div class="card-image-wrapper">
                                            ${blog.coverImageURL ? `<img src="${blog.coverImageURL}" alt="${blog.title}" loading="lazy" data-fallback="/images/default-cover.png">` : '<div class="placeholder-img"></div>'}
                                            <div class="card-overlay">
                                                <span class="read-time">${blog.readTime || 1} min read</span>
                                            </div>
                                        </div>
                                        <div class="card-content">
                                            <div class="card-tags">
                                                ${blog.category ? `<span class="tag-pill">${blog.category}</span>` : ''}
                                            </div>
                                            <h2 class="card-heading">${blog.title}</h2>
                                            <div class="card-footer-minimal">
                                                <div class="author-info">
                                                    ${blog.createdBy && blog.createdBy.profilePic ? `<img loading="lazy" src="${blog.createdBy.profilePic}" alt="Author" class="author-avatar-small" data-fallback="/images/default-avatar.png">` : '<div class="author-avatar-small placeholder"></div>'}
                                                    <span class="author-name">${blog.createdBy ? blog.createdBy.fullName : 'Unknown User'}</span>
                                                </div>
                                                <div class="interaction-stats">
                                                    <span><i class="far fa-eye"></i> ${blog.views || 0}</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            `);
                    fragment.appendChild(article);
                });

                if (document.startViewTransition) {
                    document.startViewTransition(() => {
                        bentoGrid.appendChild(fragment);
                        updateBentoPattern();
                    });
                } else {
                    bentoGrid.appendChild(fragment);
                    updateBentoPattern();
                }
            };

            // Intersection Observer for Infinite Scroll
            const sentinel = document.getElementById('sentinel');
            const observer = new IntersectionObserver((entries) => {
                if (entries[0].isIntersecting) {
                    loadMoreBlogs();
                }
            }, { threshold: 0.1 });

            observer.observe(sentinel);

            // Spotlight Coordinate Tracking
            const grid = document.getElementById('bento-grid');
            if (grid) {
                grid.addEventListener('mousemove', e => {
                    const items = grid.querySelectorAll('.bento-item:not([style*="display: none"])');
                    items.forEach(item => {
                        const rect = item.getBoundingClientRect();
                        const x = e.clientX - rect.left;
                        const y = e.clientY - rect.top;
                        item.style.setProperty('--x', `${x}px`);
                        item.style.setProperty('--y', `${y}px`);
                    });
                });
            }
        </script>

        <%- include('./partials/footer') %>
            <%- include('./partials/script') %>
</body>

</html>