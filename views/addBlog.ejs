<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('./partials/header') %>
    <link rel="stylesheet" href="/css/add-blog.css?v=20">
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <!-- Quill Rich Text Editor Theme -->
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
</head>

<body>
  <%- include('./partials/nav', { searchQuery: searchQuery || "" }) %>

    <div class="editor-container">
      <form method="post" action="/blog?_csrf=<%= csrfToken %>" enctype="multipart/form-data" id="publishForm"
        data-autosave="new-blog" novalidate>



        <!-- Title Section -->
        <div class="editor-section">
          <div class="section-header-row"
            style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h3 class="section-label" style="margin-bottom: 0;">Title</h3>

            <!-- Magic Title Button -->
            <button type="button" id="title-magic-btn" class="btn-ai-premium" data-action="generateTitles"
              title="Generate AI Titles">
              <i class="fas fa-magic"></i> AI Generate Title
            </button>
          </div>

          <div class="input-group" style="margin-bottom: 2rem; position: relative;">
            <textarea name="title" id="title" class="input-title" placeholder="Enter your story title..." rows="1"
              required data-input="autoResize"></textarea>

            <!-- Suggestions Container -->
            <div id="title-suggestions" style="display: none; margin-top: 10px; gap: 10px; flex-wrap: wrap;"></div>
          </div>
        </div>

        <!-- Professional Cover Section -->
        <div class="editor-section">
          <h3 class="section-label">Cover Image</h3>
          <div class="cover-container" id="coverContainer">
            <img loading="lazy" id="coverPreview" class="cover-preview hidden">

            <div class="cover-controls" id="coverControls">
              <div class="cover-actions">
                <!-- Manual Upload -->
                <label for="coverImage" class="btn-cover-action">
                  <i class="fas fa-cloud-upload-alt"></i> Upload Cover Image
                </label>
                <input type="file" id="coverImage" name="coverImage" accept="image/*" class="hidden-input"
                  data-change="previewCover">

                <!-- Separator -->
                <span class="divider">or</span>

                <!-- AI Generation -->
                <button type="button" class="btn-cover-action btn-ai-glass" data-action="generateCoverWithAI">
                  <i class="fas fa-magic"></i> AI Generate Cover
                </button>

                <!-- GIPHY Search (New!) -->
                <button type="button" class="btn-cover-action btn-ai-glass" data-action="searchGiphy"
                  style="color: #9333ea; border-color: #d8b4fe; background: #f3e8ff;">
                  <i class="fas fa-film"></i> Search GIF
                </button>

                <input type="hidden" id="aiCoverURL" name="aiCoverURL">
              </div>
              <p class="cover-hint">Add a high-quality cover image to attract readers.</p>
            </div>

            <button type="button" id="removeCover" class="btn-remove-cover hidden" data-action="removeCoverImage">
              <i class="fas fa-trash-alt"></i>
            </button>
          </div>
        </div>

        <!-- Main Editor Area -->
        <!-- Main Editor Area -->
        <div class="editor-section">
          <h3 class="section-label">Content</h3>
          <div class="main-editor">

            <!-- AI Writing Toolbar (Sticky/Integrates) -->
            <div class="ai-toolbar">
              <div class="tone-wrapper">
                <i class="fas fa-sliders-h"></i>
                <select id="toneSelector" class="tone-select-naked">
                  <option value="Professional">Tone: Professional</option>
                  <option value="Casual">Tone: Casual</option>
                  <option value="Funny">Tone: Funny</option>
                  <option value="Inspirational">Tone: Inspirational</option>
                  <option value="Technical">Tone: Technical</option>
                </select>
              </div>

              <div class="toolbar-divider"></div>

              <button type="button" class="btn-toolbar-ai" data-action="generateWithAI">
                <i class="fas fa-sparkles"></i> AI Continue Writing
              </button>
            </div>

            <!-- Body -->
            <div class="editor-box">
              <div id="editor" style="min-height: 400px; font-family: 'Merriweather', serif; font-size: 1.15rem;"></div>
              <input type="hidden" name="body" id="body">
            </div>
          </div>
        </div>

        <!-- Category Section -->
        <!-- Category Section -->
        <div class="editor-section">
          <h3 class="section-label">Category</h3>
          <span class="section-hint">Choose 1 main category</span>
          <div class="meta-section">
            <div class="cat-list">
              <% const categories=['Technology', 'Health' , 'Education' , 'Business' , 'Lifestyle' , 'Travel' , 'Food'
                , 'Finance' , 'Science' , 'Art' , 'Sports' , 'Music' , 'Gaming' , 'Politics' , 'History' ]; %>
                <% categories.forEach(cat=> { %>
                  <label class="cat-item">
                    <input type="radio" name="category" value="<%= cat %>" required>
                    <span>
                      <%= cat %>
                    </span>
                  </label>
                  <% }) %>
            </div>
          </div>
        </div>

        <!-- Tags Section -->
        <!-- Tags Section -->
        <div class="editor-section">
          <h3 class="section-label">Tags</h3>
          <span class="section-hint">Use 3–5 tags, comma separated</span>
          <div class="meta-section">
            <div class="tag-input-wrapper">
              <i class="fas fa-hashtag"></i>
              <input type="text" name="tags" id="tags" placeholder="Tags (comma separated)..." autocomplete="off">
              <button type="button" class="btn-mini-ai" data-action="generateTags">
                <i class="fas fa-bolt"></i> AI FIND TAGS
              </button>

            </div>
            <!-- Preview Button Moved Outside -->
            <button type="button" class="btn-mini-preview" data-action="previewStory" title="Preview Story">
              <i class="far fa-eye"></i>
            </button>
          </div>

          <!-- Moves Actions to Bottom -->
          <div class="editor-actions" style="margin-top: 30px; justify-content: flex-end; flex-wrap: wrap; gap: 10px;">
            <span id="word-count" class="word-counter" style="margin-right: 4px;">0 words</span>
            <span data-autosave-status class="autosave-status" style="margin-right: auto;"></span>
            <div class="schedule-control">
              <button type="button" id="scheduleToggle" class="schedule-pill" aria-expanded="false">
                <i class="fas fa-clock"></i>
                <span id="schedule-pill-label">Schedule for later</span>
                <i class="fas fa-chevron-down schedule-caret"></i>
              </button>
              <div id="schedule-panel" class="schedule-panel hidden">
                <div class="schedule-panel__title">Publish on</div>
                <input type="datetime-local" name="publishAt" id="publishAt" class="schedule-input">
                <div class="schedule-panel__row">
                  <span id="tz-hint" class="tz-hint"></span>
                  <button type="button" id="scheduleClear" class="schedule-clear">Clear</button>
                </div>
              </div>
            </div>
            <button type="submit" name="action" value="draft" class="btn-secondary">Save Draft</button>
            <button type="submit" name="action" value="publish" class="btn-publish">
              <span id="publish-label">Publish</span>
            </button>
            <div id="ready-hint" class="ready-hint" style="width: 100%; text-align: right;"></div>
          </div>
        </div>
        <style>
          .autosave-status { font-size: 0.78rem; color: #9ca3af; transition: color 0.2s; }
          .autosave-status.is-saving { color: #f59e0b; }
          .autosave-status.is-saved { color: #10b981; }
          .btn-publish[disabled], .btn-secondary[disabled] { opacity: 0.6; cursor: not-allowed; }
          .ready-hint { font-size: 0.78rem; margin-top: 4px; }
          .ready-hint.ok { color: #10b981; }
          .ready-hint.todo { color: #9ca3af; }
          .ready-hint .chip { display: inline-block; background: #fef2f2; color: #ef4444; border-radius: 999px; padding: 1px 8px; margin-left: 4px; font-weight: 600; }

          /* ⏰ Schedule control */
          .schedule-control { position: relative; }
          .schedule-pill {
            display: inline-flex; align-items: center; gap: 0.5rem;
            border: 1px solid #e5e7eb; background: #fff; color: #4b5563;
            font-size: 0.82rem; font-weight: 600; padding: 0.5rem 0.9rem;
            border-radius: 999px; cursor: pointer; transition: all 0.15s;
          }
          .schedule-pill:hover { border-color: #c7d2fe; background: #f5f3ff; color: #4338ca; }
          .schedule-pill .fa-clock { color: #6366f1; }
          .schedule-caret { font-size: 0.65rem; opacity: 0.6; transition: transform 0.2s; }
          .schedule-control.open .schedule-caret { transform: rotate(180deg); }
          /* Active (a date is set) */
          .schedule-pill.is-set {
            border-color: #6366f1; background: linear-gradient(90deg, #6366f1, #8b5cf6); color: #fff;
          }
          .schedule-pill.is-set .fa-clock { color: #fff; }

          .schedule-panel {
            position: absolute; bottom: calc(100% + 8px); right: 0; z-index: 50;
            width: 260px; background: #fff; border: 1px solid #e5e7eb; border-radius: 14px;
            box-shadow: 0 12px 32px rgba(0,0,0,0.14); padding: 0.9rem; text-align: left;
          }
          .schedule-panel.hidden { display: none; }
          .schedule-panel__title { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: #9ca3af; margin-bottom: 0.5rem; }
          .schedule-input {
            width: 100%; border: 1px solid #ddd; border-radius: 8px; padding: 0.5rem 0.6rem;
            font-size: 0.85rem; color: #111;
          }
          .schedule-input:focus { outline: none; border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,0.15); }
          .schedule-panel__row { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-top: 0.6rem; }
          .tz-hint { font-size: 0.7rem; color: #9ca3af; }
          .schedule-clear {
            border: none; background: transparent; color: #ef4444; font-size: 0.75rem; font-weight: 700;
            cursor: pointer; padding: 0.2rem 0.4rem; border-radius: 6px;
          }
          .schedule-clear:hover { background: #fef2f2; }
          @media (max-width: 600px) { .schedule-panel { right: auto; left: 0; } }
        </style>



      </form>

    </div>

    <!-- Pre-Publish Checklist Modal -->
    <div id="checklist-modal" class="modal-overlay hidden">
      <div class="modal-content">
        <div class="modal-header">
          <h3>🚀 Ready to Publish?</h3>
          <button type="button" class="close-modal" data-action="closeChecklist">&times;</button>
        </div>
        <div class="modal-body">
          <p class="modal-intro">Let's check if your story is ready for the world:</p>
          <ul class="checklist-items">
            <li id="check-title"><i class="far fa-circle"></i> <span>Title</span></li>
            <li id="check-cover"><i class="far fa-circle"></i> <span>Cover Image</span></li>
            <li id="check-content"><i class="far fa-circle"></i> <span>Content (50+ words)</span></li>
            <li id="check-category"><i class="far fa-circle"></i> <span>Category</span></li>
            <li id="check-tags"><i class="far fa-circle"></i> <span>Tags</span></li>
          </ul>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-secondary" data-action="closeChecklist">Keep Editing</button>
          <button type="button" id="btn-confirm-publish" class="btn-primary" data-action="submitFinal" disabled>
            Publish Now
          </button>
        </div>
      </div>
    </div>

    <%- include('./partials/footer') %>
      <%- include('./partials/script') %>

        <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
        <script nonce="<%= cspNonce %>">
          // Initialize Quill editor
          var quill = new Quill('#editor', {
            theme: 'snow',
            placeholder: 'Tell your story...',
            modules: {
              toolbar: [
                [{ 'header': [1, 2, 3, false] }],
                ['bold', 'italic', 'underline', 'strike'],
                ['blockquote', 'code-block'],
                [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                [{ 'color': [] }, { 'background': [] }],
                ['link', 'image'],
                ['clean']
              ]
            }
          });


          // Generate Title Logic
          window.generateTitles = async function () {
            if (isAiBusy) return;

            const body = quill.getText();
            const tone = document.getElementById("toneSelector").value;
            const btn = document.getElementById("title-magic-btn");
            const suggestionsDiv = document.getElementById("title-suggestions");

            if (body.trim().length < 50) {
              window.showToast("Please write some content first so AI can suggest titles!");
              return;
            }

            const originalColor = btn.style.color;
            btn.style.color = "#0066cc"; // Active color
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            isAiBusy = true;

            try {
              const response = await fetch("/ai/generate-title", {
                method: "POST",
                headers: { "Content-Type": "application/json", "x-csrf-token": "<%= csrfToken %>" },
                body: JSON.stringify({ body, tone })
              });

              const data = await response.json();

              if (!response.ok) {
                throw new Error(data.error || "Failed to generate titles");
              }

              if (data.titles && Array.isArray(data.titles)) {
                suggestionsDiv.innerHTML = "";
                suggestionsDiv.style.display = "flex";

                data.titles.forEach(title => {
                  const chip = document.createElement("button");
                  chip.type = "button";
                  chip.className = "btn-suggestion";
                  chip.innerText = title;
                  chip.style.padding = "8px 16px";
                  chip.style.border = "1px solid #eee";
                  chip.style.borderRadius = "20px";
                  chip.style.background = "#fff";
                  chip.style.cursor = "pointer";
                  chip.style.fontSize = "0.9rem";
                  chip.style.transition = "all 0.2s";

                  chip.onmouseover = () => { chip.style.background = "#f0f7ff"; chip.style.borderColor = "#0066cc"; };
                  chip.onmouseout = () => { chip.style.background = "#fff"; chip.style.borderColor = "#eee"; };

                  chip.onclick = () => {
                    document.getElementById("title").value = title;
                    autoResize(document.getElementById("title"));
                    suggestionsDiv.style.display = "none";
                  };

                  suggestionsDiv.appendChild(chip);
                });
              }

            } catch (error) {
              console.error("Title AI Error", error);
              window.showToast(error.message || "Could not generate titles.");
            } finally {
              btn.innerHTML = '<i class="fas fa-magic"></i>';
              btn.style.color = "#ccc";
              isAiBusy = false;
            }
          }

          // Custom Word Count implementation for Quill
          const bodyInput = document.getElementById("body");
          const publishForm = document.getElementById("publishForm");
          quill.on('text-change', function () {
            var text = quill.getText();
            var words = text.trim().split(/\s+/).filter(word => word.length > 0);
            document.getElementById("word-count").innerText = `${words.length} words`;

            // Keep the hidden body field current so auto-save captures the editor.
            bodyInput.value = quill.root.innerHTML;
            bodyInput.dispatchEvent(new Event("input", { bubbles: true }));
          });

          // 💾 Restore editor content when the user restores a saved draft.
          publishForm.addEventListener("autosave:restored", function () {
            if (bodyInput.value) {
              quill.setContents([]);
              quill.clipboard.dangerouslyPasteHTML(bodyInput.value);
            }
          });

          // Auto-resize textareas (Title only now)
          function autoResize(elem) {
            elem.style.height = 'auto';
            elem.style.height = elem.scrollHeight + 'px';
          }

          // Cover Image Preview
          function previewCover(input) {
            const preview = document.getElementById('coverPreview');
            const removeBtn = document.getElementById('removeCover');
            const controls = document.getElementById('coverControls');
            const container = document.getElementById('coverContainer');

            if (input.files && input.files[0]) {
              const reader = new FileReader();
              reader.onload = function (e) {
                preview.src = e.target.result;
                preview.classList.remove('hidden');
                removeBtn.classList.remove('hidden');
                controls.classList.add('hidden');
                container.style.border = 'none';
              }
              reader.readAsDataURL(input.files[0]);
            }
          }

          function removeCoverImage() {
            const input = document.getElementById('coverImage');
            const aiInput = document.getElementById('aiCoverURL');
            const preview = document.getElementById('coverPreview');
            const removeBtn = document.getElementById('removeCover');
            const controls = document.getElementById('coverControls');
            const container = document.getElementById('coverContainer');
            const aiBtn = document.querySelector('.btn-cover-action.btn-ai-glass');

            input.value = '';
            aiInput.value = '';
            preview.src = '';
            preview.classList.add('hidden');
            removeBtn.classList.add('hidden');
            controls.classList.remove('hidden'); // Show controls again
            container.style.border = '2px dashed #eee'; // Restore border

            if (aiBtn) {
              aiBtn.innerHTML = '<i class="fas fa-magic"></i> AI Generate';
              aiBtn.disabled = false;
            }
          }

          // Generate AI Cover Logic
          async function generateCoverWithAI() {
            const title = document.getElementById("title").value;
            const tone = document.getElementById("toneSelector").value;

            if (!title.trim()) {
              window.showToast("Please write a title first so AI knows what to generate!");
              return;
            }

            const aiBtn = document.querySelector('.btn-cover-action.btn-ai-glass');
            const originalText = aiBtn.innerHTML;
            aiBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';
            aiBtn.disabled = true;

            // Map Tones to Visual Styles
            const styleMap = {
              "Professional": "minimalist, corporate, clean lines, high quality, 8k, business",
              "Casual": "lifestyle, cozy, warm lighting, photorealistic, 4k",
              "Funny": "cartoon, vibrant, colorful, playful, illustration",
              "Inspirational": "majestic, sunrise, cinematic, motivational, dreamy, 8k",
              "Technical": "cyberpunk, blueprint, futuristic, tech, glowing, neon, 4k"
            };

            const selectedStyle = styleMap[tone] || "minimalist, high quality";

            // Construct Pollinations URL (Random seed to ensure uniqueness)
            const seed = Math.floor(Math.random() * 10000);
            // Prompt: Title + Tone Keywords + Generic Boosters
            const prompt = `${title}, ${selectedStyle}, detailed, aesthetically pleasing`;
            const imageUrl = `https://image.pollinations.ai/prompt/${encodeURIComponent(prompt)}?width=1200&height=600&nologo=true&seed=${seed}&model=flux`;

            const executeSuccess = (finalUrl) => {
              const preview = document.getElementById('coverPreview');
              const removeBtn = document.getElementById('removeCover');
              const controls = document.getElementById('coverControls'); // NEW
              const aiInput = document.getElementById('aiCoverURL');
              const container = document.getElementById('coverContainer'); // NEW

              preview.src = finalUrl;
              aiInput.value = finalUrl;

              preview.classList.remove('hidden');
              removeBtn.classList.remove('hidden');
              controls.classList.add('hidden');
              container.style.border = 'none'; // Remove dashed border

              aiBtn.innerHTML = originalText;
              aiBtn.disabled = false;
            };

            // Pre-load image to check success
            const img = new Image();
            img.src = imageUrl;
            img.onload = () => executeSuccess(imageUrl);
            img.onerror = () => {
              console.warn("Pollinations AI failed, falling back to random image generator...");
              const fallbackUrl = `https://picsum.photos/seed/${seed}/1200/600`;
              const fallbackImg = new Image();
              fallbackImg.src = fallbackUrl;
              fallbackImg.onload = () => executeSuccess(fallbackUrl);
              fallbackImg.onerror = () => {
                window.showToast("AI Image Service is currently down. Please try uploading an image manually.");
                aiBtn.innerHTML = originalText;
                aiBtn.disabled = false;
              };
            };
          }

          // GIPHY Search Logic
          async function searchGiphy() {
            const title = document.getElementById("title").value.trim();
            if (!title) {
              window.showToast("Please add a title first so we can find a matching GIF!");
              return;
            }

            const btn = document.querySelector('button[data-action="searchGiphy"]');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Searching...';
            btn.disabled = true;

            const searchQuery = encodeURIComponent(title + " aesthetic");

            try {
              // Use our own backend proxy to hide the key and handle errors
              const response = await fetch(`/blog/api/giphy?q=${searchQuery}`);
              const data = await response.json();

              if (!response.ok) {
                throw new Error(data.error || "Failed to fetch GIF");
              }

              if (!data.data || data.data.length === 0) {
                window.showToast("No GIFs found for this title.");
                return;
              }

              // Pick a random one from top 10 for variety
              const randomGif = data.data[Math.floor(Math.random() * data.data.length)];
              const gifUrl = randomGif.images.original.url;

              // Use existing preview logic
              const preview = document.getElementById('coverPreview');
              const removeBtn = document.getElementById('removeCover');
              const controls = document.getElementById('coverControls');
              const aiInput = document.getElementById('aiCoverURL');
              const container = document.getElementById('coverContainer');

              preview.src = gifUrl;
              aiInput.value = gifUrl;

              preview.classList.remove('hidden');
              removeBtn.classList.remove('hidden');
              controls.classList.add('hidden');
              container.style.border = 'none';

            } catch (error) {
              console.error("GIPHY Error:", error);
              window.showToast(error.message || "Failed to fetch GIF from GIPHY.");
            } finally {
              btn.innerHTML = originalText;
              btn.disabled = false;
            }
          }

          // Initialize empty resize (Title only)
          window.addEventListener('load', () => {
            autoResize(document.getElementById('title'));
          });

          let isAiBusy = false; // Global lock

          // AI Generation Logic (Adapted for Quill)
          window.generateWithAI = async function () {
            if (isAiBusy) return;

            const title = document.getElementById("title").value;
            // No direct body field anymore, using Quill
            const btn = document.querySelector('.btn-toolbar-ai');
            const tone = document.getElementById("toneSelector").value;

            if (!title.trim()) {
              window.showToast("Please add a title first.");
              return;
            }

            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Writing...';
            btn.disabled = true;
            isAiBusy = true;

            try {
              const response = await fetch("/ai/generate-blog", {
                method: "POST",
                headers: { "Content-Type": "application/json", "x-csrf-token": "<%= csrfToken %>" },
                body: JSON.stringify({ title, tone })
              });

              const data = await response.json();

              if (data.content) {
                // Insert content into Quill
                // For typewriter effect, we'd need a custom loop inserting into delta
                // For now, let's just insert basic text or HTML
                // To keep it simple and robust:

                // DOM-based Block Streaming (Robust)
                // 1. Create a dummy element to parse the HTML string
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = data.content;

                // 2. Get all top-level elements (p, h2, ul, etc.)
                // Array.from is needed to convert HTMLCollection to manageable array
                const blocks = Array.from(tempDiv.children).map(el => el.outerHTML);

                // Fallback: If no tags were found (plain text), just use the text
                if (blocks.length === 0) {
                  blocks.push(`<p>${data.content}</p>`);
                }

                let i = 0;

                function streamBlocks() {
                  if (i < blocks.length) {
                    const blockHTML = blocks[i];

                    const range = { index: quill.getLength(), length: 0 };
                    // Safely paste the HTML block
                    quill.clipboard.dangerouslyPasteHTML(range.index, blockHTML);

                    quill.scrollIntoView();

                    i++;
                    const delay = Math.floor(Math.random() * 400) + 400; // Slow cadence
                    setTimeout(streamBlocks, delay);
                  } else {
                    finishAI();
                  }
                }

                streamBlocks();

                function finishAI() {
                  btn.innerHTML = originalText;
                  btn.disabled = false;
                  isAiBusy = false;
                }

              } else {
                quill.insertText(quill.getLength() - 1, "⚠️ No content generated.");
                btn.innerHTML = originalText;
                btn.disabled = false;
                isAiBusy = false;
              }
            } catch (error) {
              console.error("AI error:", error);
              window.showToast("AI Generation Failed: " + error.message);

              // Try to reset button if found
              const btn = document.querySelector('.btn-toolbar-ai');
              if (btn) {
                btn.innerHTML = '<i class="fas fa-sparkles"></i> Auto-Complete';
                btn.disabled = false;
              }
              isAiBusy = false;
            }
          }


          // Auto-Generate Tags Logic
          window.generateTags = async function () {
            if (isAiBusy) return;

            try {
              const title = document.getElementById("title").value;
              const body = quill.getText();
              const tagsInput = document.getElementById("tags");
              const btn = document.querySelector('.btn-mini-ai'); // Corrected Selector

              if (!btn) {
                console.error("Tag AI Button not found");
                return;
              }

              if (!title) {
                window.showToast("⚠️ Please add a title first so AI can suggest tags.");
                return;
              }

              const originalText = btn.innerHTML;
              btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
              btn.disabled = true;
              isAiBusy = true;

              const response = await fetch("/ai/generate-tags", {
                method: "POST",
                headers: { "Content-Type": "application/json", "x-csrf-token": "<%= csrfToken %>" },
                body: JSON.stringify({ title, body })
              });

              const data = await response.json();

              if (!response.ok) {
                throw new Error(data.error || "Server Error");
              }

              if (data.tags) {
                const cleanTags = data.tags.replace(/["\.]/g, '');
                tagsInput.value = cleanTags;
                tagsInput.focus();
              } else {
                throw new Error("No tags generated");
              }

              btn.innerHTML = originalText;
              btn.disabled = false;
              isAiBusy = false;

            } catch (error) {
              console.error("Tag generation error:", error);
              window.showToast("Tag Generation Failed: " + error.message);

              const btn = document.querySelector('.btn-tag-ai');
              if (btn) {
                btn.innerHTML = '<i class="fas fa-bolt"></i> AI';
                btn.disabled = false;
              }
              isAiBusy = false;
            }
          }

          // Modal Logic
          const modal = document.getElementById('checklist-modal');
          const confirmBtn = document.getElementById('btn-confirm-publish');

          function closeChecklist() {
            modal.classList.add('hidden');
          }

          // Disable the action buttons and show a spinner so nobody double-submits
          // during the (several-second) cover upload + save.
          function setSubmitting(btn, label) {
            document.querySelectorAll('#publishForm button[type="submit"]').forEach(b => b.disabled = true);
            if (btn) {
              btn.disabled = true;
              btn.dataset._prev = btn.innerHTML;
              btn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> ${label}`;
            }
          }

          function submitFinal() {
            const btn = document.getElementById('btn-confirm-publish');
            setSubmitting(btn, 'Publishing…');
            document.getElementById('publishForm').submit();
          }

          // Intercept Form Submission
          let submitAction = 'publish';

          // Capture click on buttons to know action
          document.querySelectorAll('button[type="submit"]').forEach(btn => {
            btn.addEventListener('click', () => {
              submitAction = btn.value;
            });
          });

          document.getElementById('publishForm').addEventListener('submit', function (e) {
            e.preventDefault(); // Stop default submit

            // If action is draft, skip validation and submit immediately
            if (submitAction === 'draft') {
              const hiddenOp = document.createElement('input');
              hiddenOp.type = 'hidden';
              hiddenOp.name = 'action';
              hiddenOp.value = 'draft';
              this.appendChild(hiddenOp);

              // Populate body hidden input first
              document.getElementById('body').value = quill.root.innerHTML;

              const draftBtn = [...this.querySelectorAll('button[type="submit"]')].find(b => b.value === 'draft');
              setSubmitting(draftBtn, 'Saving…');
              this.submit();
              return;
            }

            const title = document.getElementById('title').value.trim();
            const bodyContent = quill.root.innerHTML;
            const textContent = quill.getText().trim();
            const wordCount = textContent.split(/\s+/).filter(word => word.length > 0).length;
            const coverImage = document.getElementById('coverImage');
            const hasAiCover = document.getElementById('aiCoverURL').value !== "";
            const category = document.querySelector('input[name="category"]:checked');
            const tags = document.getElementById('tags').value.trim();

            // Populate hidden input
            document.getElementById('body').value = bodyContent;

            // Validation State
            const checks = {
              title: !!title,
              cover: (coverImage.files && coverImage.files.length > 0) || hasAiCover,
              content: textContent && wordCount >= 50,
              category: !!category,
              tags: !!tags
            };

            // Update UI
            updateCheckItem('check-title', checks.title);
            updateCheckItem('check-cover', checks.cover);
            updateCheckItem('check-content', checks.content);
            updateCheckItem('check-category', checks.category);
            updateCheckItem('check-tags', checks.tags);

            // Enable/Disable Confirm
            const allValid = Object.values(checks).every(Boolean);
            confirmBtn.disabled = !allValid;
            if (allValid) {
              confirmBtn.classList.remove('btn-disabled');
              confirmBtn.innerHTML = "Publish Now <i class='fas fa-arrow-right'></i>";
            } else {
              confirmBtn.classList.add('btn-disabled');
              confirmBtn.innerHTML = "Fix Missing Items";
            }

            // Show Modal
            modal.classList.remove('hidden');
          });

          // 👁️ Preview Logic
          // Save the draft to the session via POST, then open the rendered
          // preview. Opening over GET (new tab, else same tab) avoids the old
          // target="_blank" + POST behaviour that broke when popups are blocked.
          async function previewStory() {
            const title = document.getElementById('title').value;
            const body = quill.root.innerHTML;
            const aiCoverURL = document.getElementById('aiCoverURL').value;
            const coverInput = document.getElementById('coverImage');

            const savePreview = async (coverBase64 = "") => {
              const csrf = "<%= csrfToken %>";
              try {
                await fetch('/blog/preview', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'x-csrf-token': csrf },
                  body: new URLSearchParams({ _csrf: csrf, title, body, aiCoverURL, coverImage: coverBase64, from: 'new' }),
                  credentials: 'include',
                  redirect: 'manual' // we don't need the response body; just persist the session
                });
              } catch (e) {
                if (window.showToast) window.showToast("Couldn't build preview. Try again.", "error");
                return;
              }
              // Open the rendered preview — new tab if allowed, else same tab.
              const win = window.open('/blog/preview', '_blank');
              if (!win) window.location.href = '/blog/preview';
            };

            if (coverInput.files && coverInput.files[0]) {
              const reader = new FileReader();
              reader.onload = (e) => savePreview(e.target.result);
              reader.readAsDataURL(coverInput.files[0]);
            } else {
              savePreview();
            }
          }
          window.previewStory = previewStory;

          function updateCheckItem(id, isValid) {
            const el = document.getElementById(id);
            const icon = el.querySelector('i');
            if (isValid) {
              el.classList.add('valid');
              el.classList.remove('invalid');
              icon.className = "fas fa-check-circle";
              icon.style.color = "#10b981"; // Green
            } else {
              el.classList.add('invalid');
              el.classList.remove('valid');
              icon.className = "far fa-circle"; // Empty circle for to-do feel, or fa-times-circle
              icon.className = "fas fa-exclamation-circle";
              icon.style.color = "#ef4444"; // Red
            }
          }

          // Close modal on outside click
          window.onclick = function (event) {
            if (event.target == modal) {
              closeChecklist();
            }
          };

          // ⏰ Scheduling control: toggle pill + popover, can't pick the past,
          // shows the reader's timezone, and flips the Publish button to Schedule.
          (function () {
            const control = document.querySelector('.schedule-control');
            const toggle = document.getElementById('scheduleToggle');
            const panel = document.getElementById('schedule-panel');
            const publishAt = document.getElementById('publishAt');
            const tzHint = document.getElementById('tz-hint');
            const pill = toggle;
            const pillLabel = document.getElementById('schedule-pill-label');
            const clearBtn = document.getElementById('scheduleClear');
            const publishLabel = document.getElementById('publish-label');
            if (!control || !publishAt) return;

            // No scheduling in the past.
            const now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            publishAt.min = now.toISOString().slice(0, 16);

            if (tzHint) {
              const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || "local time";
              tzHint.textContent = tz;
            }

            const openPanel = (open) => {
              panel.classList.toggle('hidden', !open);
              control.classList.toggle('open', open);
              toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
              if (open) setTimeout(() => publishAt.focus(), 50);
            };

            const fmt = (val) => {
              const d = new Date(val);
              if (isNaN(d)) return '';
              return d.toLocaleString(undefined, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
            };

            const refresh = () => {
              if (publishAt.value) {
                pill.classList.add('is-set');
                pillLabel.textContent = fmt(publishAt.value);
                if (publishLabel) publishLabel.textContent = 'Schedule';
              } else {
                pill.classList.remove('is-set');
                pillLabel.textContent = 'Schedule for later';
                if (publishLabel) publishLabel.textContent = 'Publish';
              }
            };

            toggle.addEventListener('click', (e) => {
              e.stopPropagation();
              openPanel(panel.classList.contains('hidden'));
            });
            publishAt.addEventListener('change', refresh);
            publishAt.addEventListener('input', refresh);
            if (clearBtn) clearBtn.addEventListener('click', () => { publishAt.value = ''; refresh(); openPanel(false); });
            document.addEventListener('click', (e) => {
              if (!control.contains(e.target)) openPanel(false);
            });
            refresh();
          })();

          // ✅ Live publish-readiness hint — tells writers what's left before they
          // hit Publish, instead of only finding out in the modal.
          (function () {
            const hint = document.getElementById('ready-hint');
            if (!hint) return;
            const refresh = () => {
              const missing = [];
              if (!document.getElementById('title').value.trim()) missing.push('title');
              const hasCover = (document.getElementById('coverImage').files || []).length > 0
                || document.getElementById('aiCoverURL').value !== "";
              if (!hasCover) missing.push('cover');
              const words = quill.getText().trim().split(/\s+/).filter(Boolean).length;
              if (words < 50) missing.push(`${50 - words} more words`);
              if (!document.querySelector('input[name="category"]:checked')) missing.push('category');
              if (!document.getElementById('tags').value.trim()) missing.push('tags');

              if (missing.length === 0) {
                hint.className = 'ready-hint ok';
                hint.innerHTML = '<i class="fas fa-check-circle"></i> Ready to publish';
              } else {
                hint.className = 'ready-hint todo';
                hint.innerHTML = 'To publish, add: ' + missing.map(m => `<span class="chip">${m}</span>`).join('');
              }
            };
            ['input', 'change'].forEach(ev => document.getElementById('publishForm').addEventListener(ev, refresh));
            quill.on('text-change', refresh);
            refresh();
          })();
        </script>
</body>

</html>