<nav class="floating-nav">
  <div class="nav-content">
    <!-- Mobile Toggle -->
    <button class="mobile-menu-btn" data-action="toggleMobileMenu">
      <i class="fas fa-bars"></i>
    </button>

    <!-- Brand -->
    <a class="nav-brand" href="/">
      <span class="brand-name">Lumina</span>
    </a>

    <!-- Center Links -->
    <ul class="nav-links">
      <li>
        <a href="/"
          class="nav-link-custom <%= (locals.path === '/' || locals.path.startsWith('/blog')) ? 'active' : '' %>">
          Blogs
        </a>
      </li>
      <li>
        <a href="/topics" class="nav-link-custom <%= (locals.path || '').startsWith('/topics') ? 'active' : '' %>">
          Topics
        </a>
      </li>
      <li>
        <a href="/earn?src=nav" class="nav-link-custom <%= (locals.path || '').startsWith('/earn') ? 'active' : '' %>">
          Earn
        </a>
      </li>
      <li>
        <a href="/mission" class="nav-link-custom <%= (locals.path === '/mission' || locals.path === '/about') ? 'active' : '' %>">
          Mission
        </a>
      </li>
      <% if (locals.user) { %>
        <!-- Search inside the mobile slide-out menu (hidden on desktop) -->
        <li class="nav-search-mobile">
          <form method="GET" action="/blog/search" role="search">
            <i class="fas fa-magnifying-glass"></i>
            <input type="text" name="q" placeholder="Search by meaning..." autocomplete="off" aria-label="Search stories" data-live-search>
          </form>
        </li>
      <% } %>
    </ul>

    <!-- Right Actions -->
    <div class="nav-actions">

      <% if (locals.user) { %>
        <!-- Search (Restricted to logged in users) -->
        <div class="search-trigger">
          <button id="searchToggle" class="icon-btn">
            <i class="fas fa-magnifying-glass"></i>
          </button>
          <form class="floating-search" method="GET" action="/blog/search" id="searchForm">
            <input id="searchInput" type="text" name="q" placeholder="Search by meaning..." autocomplete="off" data-live-search aria-label="Search stories">
          </form>
        </div>

        <a href="/blog/add-new" class="icon-btn" title="Write">
          <i class="fas fa-plus"></i>
        </a>

        <a href="/notifications" class="icon-btn position-relative">
          <i class="far fa-bell"></i>
          <span id="notification-count" class="notification-dot" style="display: none;"></span>
        </a>

        <!-- Profile Dropdown (Simplified) -->
        <div class="profile-dropdown">
          <button class="profile-trigger" type="button" style="padding: 0; border: none; background: transparent;"
            aria-label="Account menu" aria-haspopup="true" aria-expanded="false" aria-controls="account-menu">
            <% if (locals.user && locals.user.profilePic) { %>
              <img loading="lazy" src="<%= typeof optimizeImage === 'function' ? optimizeImage(locals.user.profilePic, { width: 40, height: 40, crop: 'fill' }) : locals.user.profilePic %>" 
                   alt="<%= locals.user.fullName %>" 
                   style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover;"
                   data-fallback="/images/default-avatar.png">
            <% } else { %>
              <i class="far fa-circle-user" style="font-size: 1.5rem;"></i>
            <% } %>
          </button>
          <%
            // 🔓 Items appear once they're useful or earned (services/unlockRules.js).
            const U = locals.unlocks || { has: () => true, isNew: () => false, next: [], checklist: [] };
            const me = locals.user;
            const links = [
              ['drafts', '/blog/drafts', 'My Drafts', 'fa-regular fa-file-lines'],
              ['analytics', '/user/analytics', 'Analytics', 'fa-solid fa-chart-simple'],
              ['newsletter', '/user/newsletter', 'Email Followers', 'fa-regular fa-envelope'],
              null, // divider between writing and reading
              [null, '/user/bookmarks', 'Bookmarks', 'fa-regular fa-bookmark'],
              ['highlights', '/highlights', 'Highlights', 'fa-solid fa-highlighter'],
              ['history', '/user/reading-history', 'Recently Read', 'fa-regular fa-clock'],
              ['vibe', '/user/vibe', 'Your Vibe', 'fa-solid fa-wand-magic-sparkles'],
            ].filter((l) => l === null || !l[0] || U.has(l[0]));
            // No divider at the start, end, or twice in a row.
            const rows = links.filter((l, i, a) => l !== null || (i > 0 && i < a.length - 1 && a[i - 1] !== null));
            const done = U.checklist.filter((c) => c.done).length;
            const nextStep = U.checklist.find((c) => !c.done);
          %>
          <div class="dropdown-menu-custom account-menu" id="account-menu" data-lenis-prevent>
            <a href="/user/profile" class="am-head">
              <img src="<%= typeof optimizeImage === 'function' && me.profilePic ? optimizeImage(me.profilePic, { width: 80, height: 80, crop: 'fill' }) : (me.profilePic || '/images/default-avatar.png') %>"
                   alt="" class="am-head__avatar" width="40" height="40" loading="lazy" data-fallback="/images/default-avatar.png">
              <span class="am-head__text">
                <span class="am-head__name"><%= me.fullName || 'Your profile' %></span>
                <span class="am-head__sub">View profile</span>
              </span>
              <% if (me.role === 'ADMIN') { %><span class="am-badge">Admin</span><% } %>
            </a>

            <% if (nextStep) { %>
              <a href="<%= nextStep.href %>" class="am-start">
                <span class="am-start__row">
                  <span class="am-start__title">Getting started</span>
                  <span class="am-start__count"><%= done %> of <%= U.checklist.length %></span>
                </span>
                <span class="am-bar" aria-hidden="true"><span style="width: <%= Math.round((done / U.checklist.length) * 100) %>%"></span></span>
                <span class="am-start__next">Next: <%= nextStep.label %> <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
              </a>
            <% } %>

            <a href="/blog/add-new" class="am-write"><i class="fa-solid fa-pen-nib" aria-hidden="true"></i> Write a story</a>

            <nav class="am-list" aria-label="Your account">
              <% rows.forEach(function (l) { if (l === null) { %>
                <span class="am-divider" role="separator"></span>
              <% return; } %>
                <a href="<%= l[1] %>" class="am-item">
                  <i class="<%= l[3] %>" aria-hidden="true"></i>
                  <span><%= l[2] %></span>
                  <% if (l[0] && U.isNew(l[0])) { %><span class="am-new">New</span><% } %>
                </a>
              <% }) %>
            </nav>

            <% if (U.next.length) { %>
              <a href="/user/unlocks" class="am-unlock">
                <i class="fa-solid fa-lock" aria-hidden="true"></i>
                <span class="am-unlock__text">
                  <span class="am-unlock__title">Unlock more</span>
                  <span class="am-unlock__hint">Next: <%= U.next[0].label %></span>
                </span>
                <i class="fa-solid fa-chevron-right am-chev" aria-hidden="true"></i>
              </a>
            <% } %>

            <div class="am-foot">
              <% if (me.role === 'ADMIN') { %>
                <a href="/admin" class="am-foot__link"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Admin</a>
              <% } %>
              <a href="/user/email-preferences" class="am-foot__link"><i class="fa-solid fa-gear" aria-hidden="true"></i> Settings</a>
              <a href="/user/logout" class="am-foot__link am-foot__link--out"><i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i> Log out</a>
            </div>
          </div>
        </div>

        <% } else { %>
          <div class="auth-buttons">
            <a href="/user/signin" class="nav-link-custom">Sign In</a>
            <a href="/user/signup" class="btn-pill">Get Started</a>
          </div>
          <% } %>
    </div>
  </div> <!-- Closing nav-content -->
</nav>

<script nonce="<%= cspNonce %>">
  function toggleMobileMenu() {
    const nav = document.querySelector('.floating-nav');
    const btnIcon = document.querySelector('.mobile-menu-btn i');
    nav.classList.toggle('nav-open');

    if (nav.classList.contains('nav-open')) {
      btnIcon.classList.replace('bi-list', 'bi-x-lg');
      // Lock <html>, not <body>: global.css clips overflow-x on <html>, so
      // <body>'s overflow never reaches the viewport and locking it did nothing.
      document.documentElement.style.overflow = 'hidden'; // Prevent scroll
    } else {
      btnIcon.classList.replace('bi-x-lg', 'bi-list');
      document.documentElement.style.overflow = '';
    }
  }
</script>

<!-- Global Flash Messages (Toasts) -->
<%
  // locals.error must be in this guard, not only in the branch below. Routes that
  // re-render a form directly — res.render("signup", { error: "..." }) — set it
  // without going through flash, so both *_msg arrays are empty and the whole
  // container used to be skipped: the message existed but no page ever showed it.
  // Every signup and signin failure was silent because of this.
  const hasFlash =
    (locals.success_msg && locals.success_msg.length > 0) ||
    (locals.error_msg && locals.error_msg.length > 0) ||
    (locals.error && locals.error.length > 0);
%>
<% if (hasFlash) { %>
  <div id="flash-toast-container">
    <% if (locals.success_msg && locals.success_msg.length> 0) { %>
      <div class="alert alert-success alert-dismissible fade show toast-animate" role="alert">
        <i class="fas fa-circle-check me-2"></i>
        <%= locals.success_msg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <% } %>

        <% if ((locals.error_msg && locals.error_msg.length> 0) || (locals.error && locals.error.length > 0)) { %>
          <div class="alert alert-danger alert-dismissible fade show toast-animate" role="alert">
            <i class="fas fa-triangle-exclamation me-2"></i>
            <%= (locals.error_msg && locals.error_msg.length> 0) ? locals.error_msg : locals.error %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
          <% } %>
  </div>
  <% } %>

    <!-- Bootstrap Icons (the Bootstrap JS bundle is already loaded once in the header) -->


    <!-- Scripts -->
    <% if (locals.realtimeEnabled && !locals.leanChrome) { %>
    <script nonce="<%= cspNonce %>" src="https://cdn.jsdelivr.net/npm/socket.io-client@4.8.1/dist/socket.io.min.js"></script>
    <% } %>
    <script nonce="<%= cspNonce %>">
      <% if (locals.user) { %>
      // The badge element is only rendered for a signed-in user, so for an
      // anonymous visitor this fetch always returned {count:0}, found no badge
      // and did nothing — then repeated every 10s for as long as the page stayed
      // open. Skip it entirely when there is no user.
      // Notification Count
      async function updateNotificationCount() {
        try {
          const res = await fetch("/notifications/unread-count");
          const data = await res.json();
          const badge = document.getElementById("notification-count");
          if (badge && data.count > 0) {
            badge.innerText = data.count > 99 ? '99+' : data.count;
            badge.style.display = "flex";
          } else if (badge) {
            badge.style.display = "none";
          }
        } catch (err) {
          console.error("Failed to load notification count", err);
        }
      }
      // Poll only while someone is actually looking.
      //
      // This was a flat `setInterval(..., 10000)`: every signed-in tab asked the
      // server for a number 360 times an hour, forever, including the dozen
      // tabs sitting in the background that nobody has looked at since Tuesday.
      // Each one costs an auth lookup plus a notification query.
      //
      // Now: every 60s while the tab is visible, nothing at all while it is
      // hidden, and an immediate refresh the moment it comes back -- so the
      // badge is in fact more current when it matters, at a sixth of the
      // requests when it does not.
      const NOTIF_POLL_MS = 60000;
      let notifTimer = null;

      function startNotifPolling() {
        if (notifTimer) return;
        notifTimer = setInterval(updateNotificationCount, NOTIF_POLL_MS);
      }

      function stopNotifPolling() {
        if (!notifTimer) return;
        clearInterval(notifTimer);
        notifTimer = null;
      }

      document.addEventListener("DOMContentLoaded", () => {
        updateNotificationCount();
        if (document.visibilityState === "visible") startNotifPolling();
      });

      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible") {
          updateNotificationCount();
          startNotifPolling();
        } else {
          stopNotifPolling();
        }
      });
      <% } %>

      // Search Toggle
      const searchToggle = document.getElementById('searchToggle');
      const searchForm = document.getElementById('searchForm');
      const searchInput = document.getElementById('searchInput');

      searchToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        searchForm.classList.toggle('active');
        if (searchForm.classList.contains('active')) {
          searchInput.focus();
        }
      });

      document.addEventListener('click', (e) => {
        if (searchForm && !searchForm.contains(e.target) && !searchToggle.contains(e.target)) {
          searchForm.classList.remove('active');
        }
      });

      // Profile Dropdown Toggle
      const profileTrigger = document.querySelector('.profile-trigger');
      const dropdownMenu = document.querySelector('.dropdown-menu-custom');

      const setMenu = (open) => {
        if (!dropdownMenu) return;
        dropdownMenu.classList.toggle('active', open);
        profileTrigger?.setAttribute('aria-expanded', String(open));
      };

      profileTrigger?.addEventListener('click', (e) => {
        e.stopPropagation();
        setMenu(!dropdownMenu.classList.contains('active'));
      });

      document.addEventListener('click', (e) => {
        if (dropdownMenu && !dropdownMenu.contains(e.target)) setMenu(false);
      });

      // Escape closes the menu and returns focus to the avatar button.
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && dropdownMenu?.classList.contains('active')) {
          setMenu(false);
          profileTrigger?.focus();
        }
      });

      // Foggy Toast Auto-Dismiss
      document.addEventListener("DOMContentLoaded", () => {
        const toasts = document.querySelectorAll(".toast-animate");
        toasts.forEach(toast => {
          // Wait 3 seconds, then turn to fog
          setTimeout(() => {
            toast.classList.add("fog-vanish");
            // Remove from DOM after animation finishes (1.5s)
            setTimeout(() => {
              toast.remove();
            }, 1500);
          }, 3000);
        });
      });

      // 🔄 Real-Time Notifications (only when a real-time host is available)
      <% if (locals.user && locals.realtimeEnabled) { %>
        if (typeof io === "function") {
          try {
            const socket = <%- locals.socketUrl ? `io("${locals.socketUrl}", ` : 'io(' %>{
              reconnectionAttempts: 2,
              timeout: 3000,
              autoConnect: true,
            });
            socket.on("connect_error", () => {
              socket.disconnect(); // Gracefully stop polling on serverless like Vercel
            });
            socket.emit("register", "<%= locals.user._id %>");

            socket.on("new_notification", (data) => {
              // 1. Show Toast
              const container = document.getElementById("flash-toast-container") || createToastContainer();
              const toast = document.createElement("div");
              toast.className = "alert alert-info alert-dismissible fade show toast-animate";
              toast.role = "alert";
              toast.innerHTML = `
                 <i class="fas fa-bell me-2"></i> ${data.message}
                 <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
               `;
              container.appendChild(toast);

              // Auto dismiss
              setTimeout(() => {
                toast.classList.add("fog-vanish");
                setTimeout(() => toast.remove(), 1500);
              }, 4000);

              // 2. Update Badge
              const badge = document.getElementById("notification-count");
              if (badge) {
                const current = parseInt(badge.innerText) || 0;
                badge.innerText = current + 1;
                badge.style.display = "block";
                badge.classList.add("animate-bounce"); // Optional: bounce animation
                setTimeout(() => badge.classList.remove("animate-bounce"), 500);
              }
            });
          } catch (e) {
            console.warn("Real-time notifications unavailable:", e);
          }
        }

        function createToastContainer() {
          const div = document.createElement("div");
          div.id = "flash-toast-container";
          document.body.appendChild(div);
          return div;
        }
      <% } %>
    </script>