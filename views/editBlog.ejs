<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/header') %>
        <link rel="stylesheet" href="/css/add-blog.css?v=26">
        <!-- Font Awesome for Icons -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
        <!-- Quill Rich Text Editor Theme -->
        <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
        <!-- Same code-block styling the published article uses, so what the writer
             sees while typing matches what readers get. -->
        <link rel="stylesheet" href="/css/code.css?v=2">
    <link rel="stylesheet" href="/css/editor-bubble.css?v=2">
    <link rel="stylesheet" href="/css/editor-seo.css?v=1">
</head>

<body>
    <%- include('./partials/nav', { searchQuery: searchQuery || "" }) %>

        <div class="editor-container">
            <form method="post" action="/blog/edit/<%= blog._id %>?_csrf=<%= csrfToken %>" enctype="multipart/form-data" id="publishForm"
                data-autosave="edit-blog-<%= blog._id %>" novalidate>



                <!-- Cover, then title, then the story -- the same three things the
                     new-story page shows, in the same order. Section headings over
                     every field are what made this read as a form to fill in. -->
                <div class="cover-strip <%= blog.coverImageURL ? 'has-cover' : '' %>" id="coverContainer">
                    <img loading="lazy" id="coverPreview" class="cover-preview <%= blog.coverImageURL ? '' : 'hidden' %>"
                        src="<%= blog.coverImageURL || '' %>">

                    <div class="cover-controls <%= blog.coverImageURL ? 'hidden' : '' %>" id="coverControls">
                        <label for="coverImage" class="cover-chip">
                            <i class="far fa-image"></i> Add a cover image
                        </label>
                        <input type="file" id="coverImage" name="coverImage" accept="image/*"
                            class="hidden-input" data-change="previewCover">

                        <button type="button" class="cover-chip cover-chip--ghost" data-action="generateCoverWithAI">
                            <i class="fas fa-magic"></i> Generate
                        </button>
                        <button type="button" class="cover-chip cover-chip--ghost" data-action="searchGiphy">
                            <i class="fas fa-film"></i> GIF
                        </button>

                        <input type="hidden" id="aiCoverURL" name="aiCoverURL"
                            value="<%= blog.coverImageURL && blog.coverImageURL.startsWith('http') ? blog.coverImageURL : '' %>">
                    </div>

                    <button type="button" id="removeCover"
                        class="btn-remove-cover <%= blog.coverImageURL ? '' : 'hidden' %>"
                        data-action="removeCoverImage">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </div>

                <div class="title-row">
                    <textarea name="title" id="title" class="input-title" placeholder="Title"
                        rows="1" required data-input="autoResize"><%= blog.title %></textarea>
                    <button type="button" id="title-magic-btn" class="ghost-ai" data-action="generateTitles"
                        title="Suggest titles">
                        <i class="fas fa-magic"></i> Suggest
                    </button>
                </div>
                <div id="title-suggestions" style="display: none; margin-bottom: 1rem; gap: 10px; flex-wrap: wrap;"></div>
                <div class="inline-error" id="title-error"></div>

                <!-- Main Editor Area -->
                <div class="editor-section">
                    <div class="main-editor">

                    <!-- One quiet row rather than a toolbar: the tone only matters
                         once you ask it to continue, so it sits beside that. -->
                    <div class="ai-row">
                            <button type="button" class="ghost-ai" data-action="generateWithAI">
                                <i class="fas fa-sparkles"></i> Continue writing
                            </button>
                            <select id="toneSelector" class="tone-select-naked">
                                <option value="Professional">Professional</option>
                                <option value="Casual">Casual</option>
                                <option value="Funny">Funny</option>
                                <option value="Inspirational">Inspirational</option>
                                <option value="Technical">Technical</option>
                            </select>
                    </div>

                        <!-- Body -->
                        <div class="editor-box">
                            <div id="editor"
                                style="min-height: 400px; font-family: 'Merriweather', serif; font-size: 1.15rem;">
                            </div>
                            <input type="hidden" name="body" id="body" value="<%= blog.body %>">
                        </div>
                        <div class="inline-error" id="content-error"></div>
                    </div>
                </div>

                <div class="editor-section">
                    <!-- Moves Actions to Bottom -->
                    <div class="editor-actions" style="margin-top: 30px; justify-content: flex-end;">
                        <span id="word-count" class="word-counter" style="margin-right: 4px;">0 words</span>
                        <span data-autosave-status class="autosave-status" style="margin-right: auto;"></span>
                        <button type="button" class="btn-mini-preview" data-action="previewStory" title="Preview story">
                            <i class="far fa-eye"></i>
                        </button>
                        <button type="submit" name="action" value="draft" class="btn-secondary"
                            style="margin-right: 10px;">Save Draft</button>
                        <!-- A draft has never been published, so "Update" was the wrong word
                             for the only control that publishes it: authors looked for a
                             Publish button and there wasn't one anywhere. -->
                        <button type="submit" name="action" value="publish" class="btn-publish">
                            <%= blog.status === 'published' ? 'Update' : 'Publish' %>
                        </button>
                    </div>
                </div>
                <style>
                    /* ---- The writing page: a cover strip, a title, a story. ---- */
                    .cover-strip { position: relative; margin-bottom: 1.25rem; }
                    .cover-strip .cover-controls { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
                    .cover-strip .cover-controls.hidden { display: none; }

                    .cover-strip .cover-preview {
                        position: static; display: block;
                        width: 100%; height: 220px; object-fit: cover;
                        border-radius: 12px; margin-bottom: 0.75rem;
                    }
                    .cover-strip .cover-preview.hidden { display: none; }
                    .cover-strip .btn-remove-cover { top: 12px; right: 12px; }

                    .cover-chip {
                        display: inline-flex; align-items: center; gap: 0.45rem;
                        min-height: 38px; padding: 0 0.9rem;
                        border: 1px solid #e5e7eb; border-radius: 999px; background: #fff;
                        color: #4b5563; font-size: 0.85rem; font-weight: 600; cursor: pointer;
                        transition: border-color 0.15s, color 0.15s, background 0.15s;
                    }
                    .cover-chip:hover { border-color: #c7d2fe; background: #f5f3ff; color: #4338ca; }
                    .cover-chip--ghost { color: #9ca3af; }

                    .title-row { display: flex; align-items: flex-start; gap: 0.75rem; margin-bottom: 0.25rem; }
                    .title-row .input-title { flex: 1; }

                    .ghost-ai {
                        display: inline-flex; align-items: center; gap: 0.4rem;
                        min-height: 36px; padding: 0 0.7rem;
                        border: none; border-radius: 8px; background: transparent;
                        color: #9ca3af; font: inherit; font-size: 0.82rem; font-weight: 600;
                        cursor: pointer; white-space: nowrap;
                        transition: color 0.15s, background 0.15s;
                    }
                    .ghost-ai:hover { color: #4338ca; background: #f5f3ff; }

                    .ai-row { display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.4rem; }
                    .ai-row .tone-select-naked {
                        border: none; background: transparent; color: #9ca3af;
                        font-size: 0.8rem; font-weight: 600; cursor: pointer;
                    }

                    /* ---- The publish sheet ------------------------------------- */
                    .publish-field { margin-bottom: 1.1rem; text-align: left; }
                    .publish-field__label {
                        display: block; margin-bottom: 0.4rem;
                        font-size: 0.78rem; font-weight: 700; text-transform: uppercase;
                        letter-spacing: 0.04em; color: #9ca3af;
                    }
                    .publish-select {
                        width: 100%; min-height: 44px; padding: 0 0.8rem;
                        border: 1px solid #e5e7eb; border-radius: 10px; background: #fff;
                        font: inherit; font-size: 0.92rem; color: #111; cursor: pointer;
                    }
                    .publish-select:focus {
                        outline: none; border-color: #6366f1;
                        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
                    }

                    .publish-more { margin-bottom: 1rem; text-align: left; }
                    .publish-more > summary {
                        cursor: pointer; list-style: none;
                        font-size: 0.82rem; font-weight: 600; color: #6b7280; padding: 0.5rem 0;
                    }
                    .publish-more > summary::-webkit-details-marker { display: none; }
                    .publish-more > summary::before { content: "\25B8  "; color: #9ca3af; }
                    .publish-more[open] > summary::before { content: "\25BE  "; }
                    .publish-more .seo-section { margin-top: 0.5rem; }

                    /* A row of green ticks is noise; show only what is still missing. */
                    .checklist-items li.valid { display: none; }
                    .checklist-items[hidden] { display: none; }

                    .autosave-status { font-size: 0.78rem; color: #9ca3af; transition: color 0.2s; }
                    .autosave-status.is-saving { color: #f59e0b; }
                    .autosave-status.is-saved { color: #10b981; }
                    .btn-publish[disabled], .btn-secondary[disabled] { opacity: 0.6; cursor: not-allowed; }
                </style>

                <!-- The publish sheet: the questions that only matter at the moment
                     you publish. It sits inside the form, so category, tags and the
                     search fields post exactly as they did from the page. -->
                <div id="checklist-modal" class="modal-overlay hidden">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h3><%= blog.status === 'published' ? 'Update' : 'Publish' %></h3>
                            <button type="button" class="close-modal" data-action="closeChecklist">&times;</button>
                        </div>

                        <div class="modal-body">
                            <div class="publish-field">
                                <label class="publish-field__label" for="tags">Tags</label>
                                <div class="tag-input-wrapper">
                                    <i class="fas fa-hashtag"></i>
                                    <input type="text" name="tags" id="tags" placeholder="3-5 tags, comma separated"
                                        autocomplete="off" value="<%= blog.tags.join(', ') %>">
                                    <button type="button" class="btn-mini-ai" data-action="generateTags">
                                        <i class="fas fa-bolt"></i> Suggest
                                    </button>
                                </div>
                            </div>

                            <!-- One dropdown rather than a grid of fifteen chips. The field
                                 stays because the feed's category filter and the label on
                                 every post are built on it. -->
                            <div class="publish-field">
                                <label class="publish-field__label" for="category">Category</label>
                                <select name="category" id="category" class="publish-select">
                                    <option value="">Choose one</option>
                                    <% const categories=['Technology', 'Health' , 'Education' , 'Business' , 'Lifestyle'
                                        , 'Travel' , 'Food' , 'Finance' , 'Science' , 'Art' , 'Sports' , 'Music'
                                        , 'Gaming' , 'Politics' , 'History' ]; %>
                                        <% categories.forEach(cat=> { %>
                                            <option value="<%= cat %>" <%=blog.category===cat ? 'selected' : '' %>>
                                                <%= cat %>
                                            </option>
                                            <% }) %>
                                </select>
                                <div class="inline-error" id="category-error"></div>
                            </div>

                            <details class="publish-more">
                                <summary>Search appearance</summary>
                                <!-- The permalink is shown but not editable: it was fixed when
                                     the post was created so shared links keep working. -->
                                <div class="seo-section">
                                    <div class="seo-locked">
                                        <i class="fas fa-link" aria-hidden="true"></i>
                                        <code><%= blog.slug ? '/blog/' + blog.slug : '/blog/' + blog._id %></code>
                                        <span class="seo-locked__note">Permalink can't change — it's already been shared</span>
                                    </div>

                                    <div class="seo-preview">
                                        <div class="seo-preview__url">
                                            <span class="seo-preview__host"></span><%= blog.slug ? '/blog/' + blog.slug : '/blog/' + blog._id %>
                                        </div>
                                        <div class="seo-preview__title" id="seo-title"><%= blog.title %></div>
                                        <div class="seo-preview__desc" id="seo-desc">
                                            Add a description below, or the opening lines of your story will be used.
                                        </div>
                                    </div>

                                    <div class="seo-field">
                                        <label for="metaDescription" class="seo-field__label">
                                            Meta description
                                            <span class="seo-counter" id="meta-counter">0 / 160</span>
                                        </label>
                                        <textarea name="metaDescription" id="metaDescription" rows="2" maxlength="160"
                                                  class="seo-textarea"
                                                  placeholder="One or two sentences that make someone want to click."><%= blog.metaDescription || '' %></textarea>
                                    </div>
                                </div>
                            </details>

                            <ul class="checklist-items">
                                <li id="check-title"><i class="far fa-circle"></i> <span>Title</span></li>
                                <li id="check-cover"><i class="far fa-circle"></i> <span>Cover image</span></li>
                                <li id="check-content"><i class="far fa-circle"></i> <span>50+ words</span></li>
                                <li id="check-category"><i class="far fa-circle"></i> <span>Category</span></li>
                                <li id="check-tags"><i class="far fa-circle"></i> <span>Tags</span></li>
                            </ul>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn-secondary" data-action="closeChecklist">Keep editing</button>
                            <button type="button" id="btn-confirm-publish" class="btn-primary" data-action="submitFinal" disabled>
                                <%= blog.status === 'published' ? 'Update now' : 'Publish now' %>
                            </button>
                        </div>
                    </div>
                </div>

            </form>

        </div>

        <%- include('./partials/footer') %>
            <%- include('./partials/script') %>

                <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
                <script src="/javascript/editor-images.js?v=1"></script>
                <script src="/javascript/editor-bubble.js?v=1"></script>
                <script defer src="/javascript/editor-seo.js?v=1"></script>
                <script nonce="<%= cspNonce %>">
                    // Initialize Quill editor
                    var quill = new Quill('#editor', {
                        theme: 'snow',
                        placeholder: 'Tell your story...',
                        modules: {
                            toolbar: [
                                [{ 'header': [1, 2, 3, false] }],
                                ['bold', 'italic', 'underline', 'strike'],
                                ['blockquote', 'code-block'],
                                [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                                [{ 'color': [] }, { 'background': [] }],
                                ['link', 'image'],
                                ['clean']
                            ]
                        }
                    });
                    
                    // Images go to Cloudinary instead of being inlined as base64.
                    if (window.LuminaEditorImages) window.LuminaEditorImages.attach(quill);

                  // Medium-style floating toolbar on selection. Augments the snow
                  // toolbar above rather than replacing it; see editor-bubble.js.
                  if (window.LuminaEditorBubble) window.LuminaEditorBubble.attach(quill);


                    // Pre-fill Editor Content
                    // Using a hidden div to safely decode existing HTML content
                    const bodyInput = document.getElementById('body');
                    const publishForm = document.getElementById('publishForm');
                    const initialContent = bodyInput.value;
                    quill.clipboard.dangerouslyPasteHTML(0, initialContent);
                    // Only auto-save after the editor is ready, so the initial
                    // programmatic paste above doesn't register as a user edit.
                    let editorReady = true;


                    // Generate Title Logic
                    window.generateTitles = async function () {
                        if (isAiBusy) return;

                        const body = quill.getText();
                        const tone = document.getElementById("toneSelector").value;
                        const btn = document.getElementById("title-magic-btn");
                        const suggestionsDiv = document.getElementById("title-suggestions");

                        if (body.trim().length < 50) {
                            window.showToast("Please write some content first so AI can suggest titles!");
                            return;
                        }

                        const originalColor = btn.style.color;
                        btn.style.color = "#0066cc"; // Active color
                        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                        isAiBusy = true;

                        try {
                            const response = await fetch("/ai/generate-title", {
                                method: "POST",
                                headers: { "Content-Type": "application/json", "x-csrf-token": "<%= csrfToken %>" },
                                body: JSON.stringify({ body, tone })
                            });

                            const data = await response.json();

                            if (!response.ok) {
                                throw new Error(data.error || "Failed to generate titles");
                            }

                            if (data.titles && Array.isArray(data.titles)) {
                                suggestionsDiv.innerHTML = "";
                                suggestionsDiv.style.display = "flex";

                                data.titles.forEach(title => {
                                    const chip = document.createElement("button");
                                    chip.type = "button";
                                    chip.className = "btn-suggestion";
                                    chip.innerText = title;
                                    chip.style.padding = "8px 16px";
                                    chip.style.border = "1px solid #eee";
                                    chip.style.borderRadius = "20px";
                                    chip.style.background = "#fff";
                                    chip.style.cursor = "pointer";
                                    chip.style.fontSize = "0.9rem";
                                    chip.style.transition = "all 0.2s";

                                    chip.onmouseover = () => { chip.style.background = "#f0f7ff"; chip.style.borderColor = "#0066cc"; };
                                    chip.onmouseout = () => { chip.style.background = "#fff"; chip.style.borderColor = "#eee"; };

                                    chip.onclick = () => {
                                        document.getElementById("title").value = title;
                                        autoResize(document.getElementById("title"));
                                        suggestionsDiv.style.display = "none";
                                    };

                                    suggestionsDiv.appendChild(chip);
                                });
                            }

                        } catch (error) {
                            console.error("Title AI Error", error);
                            window.showToast(error.message || "Could not generate titles.");
                        } finally {
                            btn.innerHTML = '<i class="fas fa-magic"></i>';
                            btn.style.color = "#ccc";
                            isAiBusy = false;
                        }
                    }

                    // Custom Word Count implementation for Quill
                    quill.on('text-change', function () {
                        var text = quill.getText();
                        var words = text.trim().split(/\s+/).filter(word => word.length > 0);
                        document.getElementById("word-count").innerText = `${words.length} words`;

                        // Keep hidden body current so auto-save captures edits.
                        if (editorReady) {
                            bodyInput.value = quill.root.innerHTML;
                            bodyInput.dispatchEvent(new Event("input", { bubbles: true }));
                        }
                    });

                    // 💾 Restore editor content when the user restores a saved draft.
                    publishForm.addEventListener("autosave:restored", function () {
                        if (bodyInput.value) {
                            quill.setContents([]);
                            quill.clipboard.dangerouslyPasteHTML(bodyInput.value);
                        }
                    });

                    // Trigger initial word count
                    setTimeout(() => {
                        var text = quill.getText();
                        var words = text.trim().split(/\s+/).filter(word => word.length > 0);
                        document.getElementById("word-count").innerText = `${words.length} words`;
                    }, 100);

                    // Auto-resize textareas (Title only now)
                    function autoResize(elem) {
                        elem.style.height = 'auto';
                        elem.style.height = elem.scrollHeight + 'px';
                    }

                    // Cover Image Preview
                    function previewCover(input) {
                        const preview = document.getElementById('coverPreview');
                        const removeBtn = document.getElementById('removeCover');
                        const controls = document.getElementById('coverControls');
                        const container = document.getElementById('coverContainer');

                        if (input.files && input.files[0]) {
                            const reader = new FileReader();
                            reader.onload = function (e) {
                                preview.src = e.target.result;
                                preview.classList.remove('hidden');
                                removeBtn.classList.remove('hidden');
                                controls.classList.add('hidden');
                                container.style.border = 'none';
                            }
                            reader.readAsDataURL(input.files[0]);
                        }
                    }

                    function removeCoverImage() {
                        const input = document.getElementById('coverImage');
                        const aiInput = document.getElementById('aiCoverURL');
                        const preview = document.getElementById('coverPreview');
                        const removeBtn = document.getElementById('removeCover');
                        const controls = document.getElementById('coverControls');
                        const container = document.getElementById('coverContainer');
                        const aiBtn = document.querySelector('.btn-cover-action.btn-ai-glass');

                        input.value = '';
                        aiInput.value = '';
                        preview.src = '';
                        preview.classList.add('hidden');
                        removeBtn.classList.add('hidden');
                        controls.classList.remove('hidden'); // Show controls again
                        container.style.border = '2px dashed #eee'; // Restore border

                        if (aiBtn) {
                            aiBtn.innerHTML = '<i class="fas fa-magic"></i> AI Generate';
                            aiBtn.disabled = false;
                        }
                    }

                    // Generate AI Cover Logic
                    async function generateCoverWithAI() {
                        const title = document.getElementById("title").value;
                        const tone = document.getElementById("toneSelector").value;

                        if (!title.trim()) {
                            window.showToast("Please write a title first so AI knows what to generate!");
                            return;
                        }

                        const aiBtn = document.querySelector('.btn-cover-action.btn-ai-glass');
                        const originalText = aiBtn.innerHTML;
                        aiBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';
                        aiBtn.disabled = true;

                        // Map Tones to Visual Styles
                        const styleMap = {
                            "Professional": "minimalist, corporate, clean lines, high quality, 8k, business",
                            "Casual": "lifestyle, cozy, warm lighting, photorealistic, 4k",
                            "Funny": "cartoon, vibrant, colorful, playful, illustration",
                            "Inspirational": "majestic, sunrise, cinematic, motivational, dreamy, 8k",
                            "Technical": "cyberpunk, blueprint, futuristic, tech, glowing, neon, 4k"
                        };

                        const selectedStyle = styleMap[tone] || "minimalist, high quality";

                        // Construct Pollinations URL (Random seed to ensure uniqueness)
                        const seed = Math.floor(Math.random() * 10000);
                        // Prompt: Title + Tone Keywords + Generic Boosters
                        const prompt = `${title}, ${selectedStyle}, detailed, aesthetically pleasing`;
                        const imageUrl = `https://image.pollinations.ai/prompt/${encodeURIComponent(prompt)}?width=1200&height=600&nologo=true&seed=${seed}&model=flux`;

                        const executeSuccess = (finalUrl) => {
                            const preview = document.getElementById('coverPreview');
                            const removeBtn = document.getElementById('removeCover');
                            const controls = document.getElementById('coverControls'); // NEW
                            const aiInput = document.getElementById('aiCoverURL');
                            const container = document.getElementById('coverContainer'); // NEW

                            preview.src = finalUrl;
                            aiInput.value = finalUrl;

                            preview.classList.remove('hidden');
                            removeBtn.classList.remove('hidden');
                            controls.classList.add('hidden');
                            container.style.border = 'none'; // Remove dashed border

                            aiBtn.innerHTML = originalText;
                            aiBtn.disabled = false;
                        };

                        // Pre-load image to check success
                        const img = new Image();
                        img.src = imageUrl;
                        img.onload = () => executeSuccess(imageUrl);
                        img.onerror = () => {
                            console.warn("Pollinations AI failed, falling back to random image generator...");
                            // Fallback to random image so user isn't stuck
                            const fallbackUrl = `https://picsum.photos/seed/${seed}/1200/600`;
                            const fallbackImg = new Image();
                            fallbackImg.src = fallbackUrl;
                            fallbackImg.onload = () => executeSuccess(fallbackUrl);
                            fallbackImg.onerror = () => {
                                window.showToast("AI Image Service is currently down. Please try uploading an image manually.");
                                aiBtn.innerHTML = originalText;
                                aiBtn.disabled = false;
                            };
                        };
                    }

                    // GIPHY Search Logic
                    async function searchGiphy() {
                        const title = document.getElementById("title").value.trim();
                        if (!title) {
                            window.showToast("Please add a title first so we can find a matching GIF!");
                            return;
                        }

                        const btn = document.querySelector('button[data-action="searchGiphy"]');
                        const originalText = btn.innerHTML;
                        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Searching...';
                        btn.disabled = true;

                        const searchQuery = encodeURIComponent(title + " aesthetic");

                        try {
                            const response = await fetch(`/blog/api/giphy?q=${searchQuery}`);
                            const data = await response.json();

                            if (!response.ok) {
                                throw new Error(data.error || "Failed to fetch GIF");
                            }

                            if (!data.data || data.data.length === 0) {
                                window.showToast("No GIFs found for this title.");
                                return;
                            }

                            // Pick a random one from top 10 for variety
                            const randomGif = data.data[Math.floor(Math.random() * data.data.length)];
                            const gifUrl = randomGif.images.original.url;

                            // Use existing preview logic
                            const preview = document.getElementById('coverPreview');
                            const removeBtn = document.getElementById('removeCover');
                            const controls = document.getElementById('coverControls');
                            const aiInput = document.getElementById('aiCoverURL');
                            const container = document.getElementById('coverContainer');

                            preview.src = gifUrl;
                            aiInput.value = gifUrl;

                            preview.classList.remove('hidden');
                            removeBtn.classList.remove('hidden');
                            controls.classList.add('hidden');
                            container.style.border = 'none';

                        } catch (error) {
                            console.error("GIPHY Error:", error);
                            window.showToast(error.message || "Failed to fetch GIF from GIPHY.");
                        } finally {
                            btn.innerHTML = originalText;
                            btn.disabled = false;
                        }
                    }

                    // Initialize empty resize (Title only)
                    window.addEventListener('load', () => {
                        const el = document.getElementById('title');
                        autoResize(el);
                        // Re-measure once the webfont has actually loaded.
                        //
                        // The title is set at 3.5rem in Inter. autoResize measures scrollHeight
                        // against whatever font is active when it runs, and at 'load' that is
                        // often still the fallback, which is shorter. It wrote that height to
                        // the element, Inter swapped in a moment later, and nothing re-ran — so
                        // the box stayed 37px tall around a 65px line, and overflow:hidden kept
                        // the title visibly cut off on every single page load.
                        if (document.fonts && document.fonts.ready) {
                            document.fonts.ready.then(() => autoResize(el));
                        }
                    });

                    let isAiBusy = false; // Global lock

                    // AI Generation Logic (Adapted for Quill)
                    window.generateWithAI = async function () {
                        if (isAiBusy) return;

                        const title = document.getElementById("title").value;
                        // No direct body field anymore, using Quill
                        const btn = document.querySelector('.btn-toolbar-ai');
                        const tone = document.getElementById("toneSelector").value;

                        if (!title.trim()) {
                            window.showToast("Please add a title first.");
                            return;
                        }

                        const originalText = btn.innerHTML;
                        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Writing...';
                        btn.disabled = true;
                        isAiBusy = true;

                        try {
                            const response = await fetch("/ai/generate-blog", {
                                method: "POST",
                                headers: { "Content-Type": "application/json", "x-csrf-token": "<%= csrfToken %>" },
                                body: JSON.stringify({ title, tone })
                            });

                            const data = await response.json();

                            if (data.content) {
                                // Insert content into Quill
                                // DOM-based Block Streaming (Robust)
                                const tempDiv = document.createElement('div');
                                tempDiv.innerHTML = data.content;

                                const blocks = Array.from(tempDiv.children).map(el => el.outerHTML);

                                // Fallback: If no tags were found (plain text), just use the text
                                if (blocks.length === 0) {
                                    blocks.push(`<p>${data.content}</p>`);
                                }

                                let i = 0;

                                function streamBlocks() {
                                    if (i < blocks.length) {
                                        const blockHTML = blocks[i];

                                        const range = { index: quill.getLength(), length: 0 };
                                        // Safely paste the HTML block
                                        quill.clipboard.dangerouslyPasteHTML(range.index, blockHTML);

                                        quill.scrollIntoView();

                                        i++;
                                        const delay = Math.floor(Math.random() * 400) + 400; // Slow cadence
                                        setTimeout(streamBlocks, delay);
                                    } else {
                                        finishAI();
                                    }
                                }

                                streamBlocks();

                                function finishAI() {
                                    btn.innerHTML = originalText;
                                    btn.disabled = false;
                                    isAiBusy = false;
                                }

                            } else {
                                quill.insertText(quill.getLength() - 1, "⚠️ No content generated.");
                                btn.innerHTML = originalText;
                                btn.disabled = false;
                                isAiBusy = false;
                            }
                        } catch (error) {
                            console.error("AI error:", error);
                            window.showToast("AI Generation Failed: " + error.message);

                            // Try to reset button if found
                            const btn = document.querySelector('.btn-toolbar-ai');
                            if (btn) {
                                btn.innerHTML = '<i class="fas fa-sparkles"></i> Auto-Complete';
                                btn.disabled = false;
                            }
                            isAiBusy = false;
                        }
                    }


                    // Auto-Generate Tags Logic
                    window.generateTags = async function () {
                        if (isAiBusy) return;

                        try {
                            const title = document.getElementById("title").value;
                            const body = quill.getText();
                            const tagsInput = document.getElementById("tags");
                            const btn = document.querySelector('.btn-mini-ai'); // Corrected Selector

                            if (!btn) {
                                console.error("Tag AI Button not found");
                                return;
                            }

                            if (!title) {
                                window.showToast("⚠️ Please add a title first so AI can suggest tags.");
                                return;
                            }

                            const originalText = btn.innerHTML;
                            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                            btn.disabled = true;
                            isAiBusy = true;

                            const response = await fetch("/ai/generate-tags", {
                                method: "POST",
                                headers: { "Content-Type": "application/json", "x-csrf-token": "<%= csrfToken %>" },
                                body: JSON.stringify({ title, body })
                            });

                            const data = await response.json();

                            if (!response.ok) {
                                throw new Error(data.error || "Server Error");
                            }

                            if (data.tags) {
                                const cleanTags = data.tags.replace(/["\.]/g, '');
                                tagsInput.value = cleanTags;
                                tagsInput.focus();
                            } else {
                                throw new Error("No tags generated");
                            }

                            btn.innerHTML = originalText;
                            btn.disabled = false;
                            isAiBusy = false;

                        } catch (error) {
                            console.error("Tag generation error:", error);
                            window.showToast("Tag Generation Failed: " + error.message);

                            const btn = document.querySelector('.btn-tag-ai');
                            if (btn) {
                                btn.innerHTML = '<i class="fas fa-bolt"></i> AI';
                                btn.disabled = false;
                            }
                            isAiBusy = false;
                        }
                    }

                    // Modal Logic
                    const modal = document.getElementById('checklist-modal');
                    const confirmBtn = document.getElementById('btn-confirm-publish');

                    function closeChecklist() {
                        modal.classList.add('hidden');
                    }

                    function setSubmitting(btn, label) {
                        document.querySelectorAll('#publishForm button[type="submit"]').forEach(b => b.disabled = true);
                        if (btn) {
                            btn.disabled = true;
                            btn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> ${label}`;
                        }
                    }

                    // form.submit() does NOT carry the clicked button's name and value,
                    // so the POST arrived with no `action` at all -- and the edit route
                    // only takes a draft live when it sees action=publish. That is why
                    // the editor's Publish button saved the draft and left it a draft.
                    function setAction(form, value) {
                        let field = form.querySelector('input[type="hidden"][name="action"]');
                        if (!field) {
                            field = document.createElement('input');
                            field.type = 'hidden';
                            field.name = 'action';
                            form.appendChild(field);
                        }
                        field.value = value;
                    }

                    function submitFinal() {
                        const form = document.getElementById('publishForm');
                        setAction(form, 'publish');
                        setSubmitting(document.getElementById('btn-confirm-publish'), '<%= blog.status === "published" ? "Updating…" : "Publishing…" %>');
                        form.submit();
                    }

                    // Readiness, recomputed on every keystroke rather than only on
                    // submit: tags and category are answered inside the sheet now, so
                    // the button has to come alive while the sheet is already open.
                    function runChecks() {
                        const title = document.getElementById('title').value.trim();
                        const textContent = quill.getText().trim();
                        const wordCount = textContent.split(/\s+/).filter(Boolean).length;
                        const coverImage = document.getElementById('coverImage');
                        const hasCover = (coverImage.files && coverImage.files.length > 0)
                            || document.getElementById('aiCoverURL').value !== ""
                            || !document.getElementById('coverPreview').classList.contains('hidden');
                        const category = document.getElementById('category').value;

                        const checks = {
                            title: !!title,
                            cover: hasCover,
                            content: !!textContent && wordCount >= 50,
                            category: !!category,
                            tags: !!document.getElementById('tags').value.trim()
                        };

                        updateCheckItem('check-title', checks.title);
                        updateCheckItem('check-cover', checks.cover);
                        updateCheckItem('check-content', checks.content);
                        updateCheckItem('check-category', checks.category);
                        updateCheckItem('check-tags', checks.tags);

                        if (!checks.title) document.getElementById('title-error').textContent = "\u26a0\ufe0f Please enter a title for your story.";
                        if (!checks.content) document.getElementById('content-error').textContent = textContent
                            ? `\u26a0\ufe0f Too short! Please write at least 50 words (currently ${wordCount}).`
                            : "\u26a0\ufe0f Your story is empty. Start writing!";
                        if (!checks.category) document.getElementById('category-error').textContent = "\u26a0\ufe0f Please select a category.";

                        const allValid = Object.values(checks).every(Boolean);
                        confirmBtn.disabled = !allValid;
                        confirmBtn.classList.toggle('btn-disabled', !allValid);
                        confirmBtn.innerHTML = allValid
                            ? "<%= blog.status === 'published' ? 'Update now' : 'Publish now' %> <i class='fas fa-arrow-right'></i>"
                            : "Fix missing items";

                        const list = document.querySelector('.checklist-items');
                        if (list) list.hidden = allValid;
                        return allValid;
                    }

                    // Guess the category from the tags so the dropdown is usually already
                    // answered. Never overrides what the author picked, or what they chose
                    // when the post was first written.
                    (function () {
                        const tagsInput = document.getElementById('tags');
                        const select = document.getElementById('category');
                        if (!tagsInput || !select) return;
                        const known = [...select.options].map(o => o.value).filter(Boolean);
                        let touched = false;
                        select.addEventListener('change', () => { touched = true; });
                        tagsInput.addEventListener('input', () => {
                            if (touched || select.value) return;
                            const tags = tagsInput.value.toLowerCase().split(',').map(t => t.trim());
                            const hit = known.find(c => tags.includes(c.toLowerCase()));
                            if (hit) select.value = hit;
                        });
                    })();

                    // Intercept Form Submission
                    let submitAction = 'publish';

                    // Capture click on buttons to know action
                    document.querySelectorAll('button[type="submit"]').forEach(btn => {
                        btn.addEventListener('click', () => {
                            submitAction = btn.value;
                        });
                    });

                    document.getElementById('publishForm').addEventListener('submit', function (e) {
                        e.preventDefault(); // Stop default submit

                        // If action is draft, skip validation and submit immediately
                        if (submitAction === 'draft') {
                            // One reusable field, so a Save Draft followed by a Publish cannot
                            // send action twice with the first value winning.
                            setAction(this, 'draft');

                            // Populate body hidden input first
                            document.getElementById('body').value = quill.root.innerHTML;

                            const draftBtn = [...this.querySelectorAll('button[type="submit"]')].find(b => b.value === 'draft');
                            setSubmitting(draftBtn, 'Saving…');
                            this.submit();
                            return;
                        }

                        document.querySelectorAll('.inline-error').forEach(el => el.textContent = '');
                        document.getElementById('body').value = quill.root.innerHTML;
                        runChecks();

                        // Show Modal
                        modal.classList.remove('hidden');
                    });

                    // Shown only when the browser refuses the preview tab. The story is
                    // already saved to the session at this point, so all that is missing is
                    // a way to open it that does not cost the author their unsaved edits.
                    function offerPreviewLink() {
                        const existing = document.getElementById('preview-blocked');
                        if (existing) existing.remove();

                        const bar = document.createElement('div');
                        bar.id = 'preview-blocked';
                        bar.style.cssText = 'position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:9999;display:flex;align-items:center;gap:12px;max-width:92vw;padding:12px 16px;border-radius:12px;background:#111827;color:#fff;box-shadow:0 10px 30px rgba(0,0,0,.4);font-size:.9rem;';

                        const text = document.createElement('span');
                        text.textContent = 'Preview is ready \u2014 your browser blocked the new tab.';

                        const link = document.createElement('a');
                        link.href = '/blog/preview';
                        link.target = '_blank';
                        link.rel = 'noopener';
                        link.textContent = 'Open preview';
                        link.style.cssText = 'display:inline-flex;align-items:center;min-height:40px;padding:0 14px;border-radius:8px;background:#6366f1;color:#fff;font-weight:600;text-decoration:none;white-space:nowrap;';
                        link.addEventListener('click', () => bar.remove());

                        bar.append(text, link);
                        document.body.appendChild(bar);
                    }

                    // 👁️ Preview Logic — save to session via POST, then open the
                    // rendered preview over GET (new tab, else same tab).
                    async function previewStory() {
                        const title = document.getElementById('title').value;
                        const body = quill.root.innerHTML;
                        const aiCoverURL = document.getElementById('aiCoverURL').value;
                        const coverInput = document.getElementById('coverImage');

                        // Opened NOW, while the click is still the browser's idea of a user
                        // gesture. Calling window.open after the await below is what made popup
                        // blockers refuse it — and the fallback then navigated the editor away,
                        // which looks exactly like "preview is broken".
                        const win = window.open('', '_blank');

                        const fail = (message) => {
                            if (win) win.close();
                            if (window.showToast) window.showToast(message, "error");
                            else alert(message);
                        };

                        const savePreview = async (coverBase64 = "") => {
                            const csrf = "<%= csrfToken %>";
                            let res;
                            try {
                                res = await fetch('/blog/preview', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'x-csrf-token': csrf },
                                    body: new URLSearchParams({ _csrf: csrf, title, body, aiCoverURL, coverImage: coverBase64, from: 'edit', editId: '<%= blog._id %>' }),
                                    credentials: 'include',
                                    redirect: 'manual'
                                });
                            } catch (e) {
                                return fail("Couldn't build preview. Check your connection and try again.");
                            }

                            // `redirect: 'manual'` makes a redirect come back as an opaque response
                            // with status 0, which is the success case here. Anything else that is
                            // not 2xx really did fail, and used to be ignored — the preview tab
                            // opened anyway and showed nothing, or last time's story.
                            const ok = res.type === 'opaqueredirect' || res.status === 0 || res.ok;
                            if (!ok) {
                                return fail(res.status === 413
                                    ? "This story is too large to preview with that cover image. Try a smaller one."
                                    : "Couldn't build preview. Please try again.");
                            }

                            if (win) { win.location = '/blog/preview'; return; }
                            // The pop-up was blocked. Navigating this tab instead would throw
                            // away everything typed since the last save, so offer a link: a
                            // click on it is a fresh gesture, which is never blocked.
                            offerPreviewLink();
                        };

                        // A cover the author picked but has not uploaded yet can only be shown in
                        // the preview by sending it along. Past this size it is dropped rather
                        // than failing the whole preview over an image that is about to be
                        // uploaded properly anyway.
                        const MAX_PREVIEW_COVER = 1.5 * 1024 * 1024;

                        if (coverInput && coverInput.files && coverInput.files[0]) {
                            if (coverInput.files[0].size > MAX_PREVIEW_COVER) {
                                savePreview();
                            } else {
                                const reader = new FileReader();
                                reader.onload = (e) => savePreview(e.target.result);
                                reader.onerror = () => savePreview();
                                reader.readAsDataURL(coverInput.files[0]);
                            }
                        } else {
                            savePreview();
                        }
                    }

                    window.previewStory = previewStory;

                    // The sheet's readiness has to track what is typed inside it.
                    ['input', 'change'].forEach(ev =>
                        document.getElementById('publishForm').addEventListener(ev, runChecks));
                    quill.on('text-change', runChecks);

                    function updateCheckItem(id, isValid) {
                        const el = document.getElementById(id);
                        const icon = el.querySelector('i');
                        if (isValid) {
                            el.classList.add('valid');
                            el.classList.remove('invalid');
                            icon.className = "fas fa-check-circle";
                            icon.style.color = "#10b981"; // Green
                        } else {
                            el.classList.add('invalid');
                            el.classList.remove('valid');
                            icon.className = "far fa-circle"; // Empty circle for to-do feel, or fa-times-circle
                            icon.className = "fas fa-exclamation-circle";
                            icon.style.color = "#ef4444"; // Red
                        }
                    }

                    // Close modal on outside click
                    window.onclick = function (event) {
                        if (event.target == modal) {
                            closeChecklist();
                        }
                    }
                </script>
</body>

</html>